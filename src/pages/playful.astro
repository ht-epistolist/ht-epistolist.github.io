---
// Funny / Playful page - Leucauge venusta Orchard Orbweaver & Spotify
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Funny — Olena Teslia</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      width: 100%;
      background: linear-gradient(180deg, #1e3a2b 0%, #2e593d 30%, #688a5e 60%, #c49a6c 85%, #784c31 100%);
      font-family: 'Work Sans', sans-serif;
      overflow: hidden;
      user-select: none;
    }

    /* Sun */
    .sun {
      position: fixed;
      top: 6vh;
      left: 10vw;
      width: 70px;
      height: 70px;
      background: #fde047;
      border-radius: 50%;
      box-shadow: 0 0 45px 18px rgba(253, 224, 71, 0.4);
      animation: sunPulse 4s ease-in-out infinite alternate;
      z-index: 1;
    }
    @keyframes sunPulse {
      from { box-shadow: 0 0 45px 18px rgba(253, 224, 71, 0.4); }
      to   { box-shadow: 0 0 65px 28px rgba(253, 224, 71, 0.6); }
    }

    /* Ground & Grass */
    .ground {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 30vh;
      background: #5c3822;
      border-radius: 50% 50% 0 0 / 8% 8% 0 0;
      z-index: 2;
    }
    .grass {
      position: fixed;
      bottom: 28vh;
      left: 0;
      right: 0;
      height: 5vh;
      background: #15803d;
      border-radius: 50% 50% 0 0 / 40% 40% 0 0;
      z-index: 2;
    }

    /* The Hole */
    .hole-wrapper {
      position: fixed;
      bottom: 26vh;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 3;
    }

    .hole {
      width: 80px;
      height: 0;
      background: #140702;
      border-radius: 50%;
      animation: digHole 3s ease-in forwards;
      animation-delay: 0.5s;
      box-shadow: inset 0 10px 20px rgba(0,0,0,0.8);
    }
    @keyframes digHole {
      0%   { width: 30px; height: 0px; }
      30%  { width: 70px; height: 20px; }
      60%  { width: 85px; height: 50px; }
      100% { width: 90px; height: 90px; }
    }

    /* Dirt Pile */
    .pile {
      position: fixed;
      bottom: 29.5vh;
      left: calc(50% + 55px);
      width: 0;
      height: 0;
      background: #3e1f0e;
      border-radius: 50% 50% 0 0;
      animation: growPile 3s ease-in forwards;
      animation-delay: 0.5s;
      z-index: 3;
    }
    @keyframes growPile {
      0%   { width: 0px;  height: 0px; }
      40%  { width: 40px; height: 20px; }
      100% { width: 65px; height: 40px; }
    }

    /* Stickman */
    .stickman-wrap {
      position: fixed;
      bottom: calc(29vh - 10px);
      left: calc(50% - 70px);
      z-index: 4;
      animation: stickmanSink 3s ease-in forwards;
      animation-delay: 0.5s;
    }
    @keyframes stickmanSink {
      0%   { transform: translateY(0); }
      50%  { transform: translateY(8px); }
      100% { transform: translateY(18px); }
    }

    .stickman {
      animation: digBody 0.5s ease-in-out infinite alternate;
      transform-origin: 30px 65px;
    }
    @keyframes digBody {
      from { transform: rotate(-5deg); }
      to   { transform: rotate(10deg); }
    }

    .arm-right {
      animation: armDig 0.5s ease-in-out infinite alternate;
      transform-origin: 30px 42px;
    }
    @keyframes armDig {
      from { transform: rotate(-60deg); }
      to   { transform: rotate(30deg); }
    }
    .arm-left {
      animation: armDig2 0.5s ease-in-out infinite alternate;
      transform-origin: 30px 42px;
    }
    @keyframes armDig2 {
      from { transform: rotate(30deg); }
      to   { transform: rotate(-60deg); }
    }

    .leg-right {
      animation: legR 0.5s ease-in-out infinite alternate;
      transform-origin: 30px 70px;
    }
    @keyframes legR {
      from { transform: rotate(10deg); }
      to   { transform: rotate(-10deg); }
    }
    .leg-left {
      animation: legL 0.5s ease-in-out infinite alternate;
      transform-origin: 30px 70px;
    }
    @keyframes legL {
      from { transform: rotate(-10deg); }
      to   { transform: rotate(10deg); }
    }

    /* Particles */
    .particles {
      position: fixed;
      bottom: 30vh;
      left: 50%;
      pointer-events: none;
      z-index: 4;
    }
    .particle {
      position: absolute;
      width: 8px;
      height: 8px;
      background: #5c3822;
      border-radius: 50%;
      animation: flyDirt var(--dur) ease-out infinite;
      animation-delay: var(--delay);
      opacity: 0;
    }
    @keyframes flyDirt {
      0%   { transform: translate(0, 0) scale(1); opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)) scale(0.2); opacity: 0; }
    }

    /* Back Button */
    .back {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      font-family: 'Work Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(8, 13, 10, 0.6);
      padding: 6px 14px;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.15);
      backdrop-blur: 8px;
      text-decoration: none;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      z-index: 50;
    }
    .back:hover {
      background: rgba(5, 150, 105, 0.8);
      color: #ffffff;
      border-color: #34d399;
    }

    /* Construction Tape Strips */
    .construction-tape {
      position: fixed;
      left: -10vw;
      width: 120vw;
      height: 48px;
      background: #facc15;
      color: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Work Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(0.95rem, 2.2vw, 1.5rem);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
      border-top: 4px dashed #000;
      border-bottom: 4px dashed #000;
      pointer-events: none;
      z-index: 30;
      overflow: hidden;
      white-space: nowrap;
    }

    .tape-top {
      top: 24vh;
      transform: rotate(-4.5deg);
    }

    .tape-bottom {
      bottom: 22vh;
      transform: rotate(3.5deg);
    }

    .tape-track {
      display: flex;
      gap: 2.5rem;
      align-items: center;
    }

    .hazard {
      color: #111;
      opacity: 0.7;
      letter-spacing: 0.25em;
      font-weight: 900;
    }

    /* Progress Text */
    .progress-text {
      position: fixed;
      bottom: 12vh;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Work Sans', sans-serif;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.8);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 10;
    }

    /* ------------------------------------------------------------- */
    /* LEUCAUGE VENUSTA (ORCHID ORBWEAVER) SPIDER & WEB INTERACTION */
    /* ------------------------------------------------------------- */
    .web-container {
      position: fixed;
      top: 0;
      right: 0;
      width: 320px;
      height: 320px;
      pointer-events: none;
      z-index: 15;
    }

    .spider-unit {
      position: fixed;
      top: 0;
      right: 18vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      z-index: 45;
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .silk-thread {
      width: 1.5px;
      height: 140px;
      background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(167,243,208,0.9) 100%);
      box-shadow: 0 0 8px rgba(16,185,129,0.5);
      transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .spider-body-svg {
      width: 54px;
      height: 64px;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));
      transition: transform 0.2s ease;
    }
    .spider-unit:hover .spider-body-svg {
      transform: scale(1.1);
    }

    .spider-tag {
      margin-top: 6px;
      background: rgba(8,13,10,0.8);
      color: #34d399;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 3px 8px;
      border-radius: 12px;
      border: 1px solid rgba(52,211,153,0.4);
      white-space: nowrap;
      pointer-events: none;
      transition: opacity 0.3s;
    }

    /* Interactive Silk Canvas */
    #silk-canvas {
      position: fixed;
      inset: 0;
      pointer-events: auto;
      z-index: 12;
    }

    /* ------------------------------------------------------------- */
    /* SPOTIFY PROFILE WIDGET */
    /* ------------------------------------------------------------- */
    .spotify-widget {
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      z-index: 45;
      background: rgba(8, 13, 10, 0.9);
      border: 1px solid rgba(52, 211, 153, 0.35);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      border-radius: 16px;
      padding: 12px;
      width: 320px;
      backdrop-filter: blur(12px);
      transition: all 0.3s ease;
    }

    .spotify-widget.collapsed {
      width: auto;
      padding: 8px 14px;
      border-radius: 24px;
    }

    .spotify-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .spotify-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 700;
    }
    .spotify-brand:hover {
      color: #1ed760;
    }

    .toggle-btn {
      background: rgba(255,255,255,0.1);
      border: none;
      color: #cbd5e1;
      padding: 2px 8px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.75rem;
      font-family: inherit;
    }
    .toggle-btn:hover {
      background: rgba(255,255,255,0.2);
      color: #fff;
    }

    .spotify-body {
      margin-top: 10px;
    }
    .spotify-widget.collapsed .spotify-body {
      display: none;
    }

    .playlist-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 8px;
    }
    .playlist-pill {
      font-size: 0.68rem;
      padding: 2px 7px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.15);
      color: #6ee7b7;
      border: 1px solid rgba(16, 185, 129, 0.3);
      text-decoration: none;
      transition: all 0.15s;
    }
    .playlist-pill:hover {
      background: rgba(16, 185, 129, 0.35);
      color: #fff;
    }

    @media (max-width: 640px) {
      .spider-unit { right: 8vw; }
      .spotify-widget {
        bottom: 0.75rem;
        left: 0.75rem;
        right: 0.75rem;
        width: auto;
      }
    }
  </style>
</head>
<body>

  <!-- Interactive Silk Canvas for Click-to-Spin web threads -->
  <canvas id="silk-canvas"></canvas>

  <!-- Orchard Orbweb in upper right corner -->
  <svg class="web-container" viewBox="0 0 300 300" fill="none" stroke="rgba(255,255,255,0.25)">
    <!-- Radial structural threads -->
    <line x1="300" y1="0" x2="20" y2="280" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="60" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="140" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="220" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="0" y2="180" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="0" y2="90" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    
    <!-- Concentric spiral loops -->
    <path d="M 120 20 A 180 180 0 0 0 280 180" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 80 40 A 220 220 0 0 0 260 220" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 40 70 A 260 260 0 0 0 230 260" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 10 110 A 290 290 0 0 0 200 290" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />

    <!-- Dewdrops on web nodes -->
    <circle cx="210" cy="110" r="2.5" fill="#a7f3d0" opacity="0.8"/>
    <circle cx="170" cy="150" r="3" fill="#ffffff" opacity="0.9"/>
    <circle cx="120" cy="190" r="2.5" fill="#a7f3d0" opacity="0.7"/>
    <circle cx="240" cy="80" r="2" fill="#ffffff" opacity="0.8"/>
  </svg>

  <!-- Interactive Leucauge Venusta (Orchard Orbweaver) Spider Unit -->
  <div class="spider-unit" id="spider" title="Click me to drop!">
    <div class="silk-thread" id="spider-thread"></div>
    
    <!-- Anatomically themed Leucauge venusta SVG -->
    <svg class="spider-body-svg" viewBox="0 0 100 120">
      <!-- 8 Jointed Spider Legs (emerald / amber jointed) -->
      <g stroke="#a3e635" stroke-width="3" stroke-linecap="round" fill="none">
        <!-- Anterior Leg pair I -->
        <path d="M 45 40 Q 20 15 5 25" />
        <path d="M 55 40 Q 80 15 95 25" />
        <!-- Leg pair II -->
        <path d="M 43 45 Q 15 35 8 55" />
        <path d="M 57 45 Q 85 35 92 55" />
        <!-- Leg pair III -->
        <path d="M 44 52 Q 22 55 12 75" />
        <path d="M 56 52 Q 78 55 88 75" />
        <!-- Posterior Leg pair IV -->
        <path d="M 45 58 Q 25 85 18 105" />
        <path d="M 55 58 Q 75 85 82 105" />
      </g>
      
      <!-- Cephalothorax (amber / dark olive) -->
      <ellipse cx="50" cy="48" rx="8" ry="11" fill="#14532d" stroke="#10b981" stroke-width="1.5" />
      
      <!-- Chelicerae / Pedipalps -->
      <circle cx="48" cy="38" r="2" fill="#facc15"/>
      <circle cx="52" cy="38" r="2" fill="#facc15"/>

      <!-- Abdomen (Leucauge Venusta: bright metallic emerald, silver dorsal stripes, fiery ventral orange spots) -->
      <ellipse cx="50" cy="74" rx="14" ry="22" fill="#059669" stroke="#34d399" stroke-width="2" />
      
      <!-- Silver pearlescent dorsal bands -->
      <path d="M 42 56 Q 44 74 42 92" stroke="#f1f5f9" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path d="M 58 56 Q 56 74 58 92" stroke="#f1f5f9" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <line x1="50" y1="58" x2="50" y2="90" stroke="#047857" stroke-width="1.5" />

      <!-- Iconic Leucauge Venusta ventral fiery flame-orange marking -->
      <circle cx="50" cy="85" r="4.5" fill="#f97316" stroke="#ea580c" stroke-width="1.5" />
      <circle cx="50" cy="85" r="2" fill="#fde047" />
    </svg>

    <span class="spider-tag" id="spider-status">Leucauge venusta (click!)</span>
  </div>

  <!-- Construction Tape Strips -->
  <div class="construction-tape tape-top" aria-hidden="true">
    <div class="tape-track">
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
    </div>
  </div>

  <div class="construction-tape tape-bottom" aria-hidden="true">
    <div class="tape-track">
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
    </div>
  </div>

  <!-- Navigation -->
  <a href="/" class="back">← back</a>

  <!-- Sun & Ground -->
  <div class="sun"></div>
  <div class="grass"></div>
  <div class="ground"></div>

  <!-- The Hole -->
  <div class="hole-wrapper">
    <div class="hole"></div>
  </div>

  <!-- Dirt Mound -->
  <div class="pile"></div>

  <!-- Particles -->
  <div class="particles" id="particles"></div>

  <!-- Stickman Excavator -->
  <div class="stickman-wrap">
    <svg width="100" height="120" viewBox="0 0 100 120" class="stickman">
      <!-- Head -->
      <circle cx="30" cy="22" r="12" stroke="#111" stroke-width="3" fill="none"/>
      
      <!-- Torso -->
      <line x1="30" y1="34" x2="30" y2="70" stroke="#111" stroke-width="3"/>

      <!-- Shovel and Right Arm -->
      <g class="arm-right">
        <line x1="30" y1="42" x2="48" y2="60" stroke="#111" stroke-width="3" stroke-linecap="round"/>
        <!-- Shovel shaft -->
        <line x1="42" y1="50" x2="72" y2="92" stroke="#4b2e1e" stroke-width="3" stroke-linecap="round"/>
        <!-- Shovel blade -->
        <path d="M 68 87 L 82 98 L 72 104 Z" fill="#94a3b8" stroke="#475569" stroke-width="1.5"/>
      </g>

      <!-- Left Arm -->
      <g class="arm-left">
        <line x1="30" y1="42" x2="16" y2="58" stroke="#111" stroke-width="3" stroke-linecap="round"/>
        <line x1="16" y1="58" x2="42" y2="55" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
      </g>

      <!-- Right Leg -->
      <g class="leg-right">
        <line x1="30" y1="70" x2="42" y2="95" stroke="#111" stroke-width="3" stroke-linecap="round"/>
        <line x1="42" y1="95" x2="50" y2="95" stroke="#111" stroke-width="3" stroke-linecap="round"/>
      </g>

      <!-- Left Leg -->
      <g class="leg-left">
        <line x1="30" y1="70" x2="18" y2="95" stroke="#111" stroke-width="3" stroke-linecap="round"/>
        <line x1="18" y1="95" x2="10" y2="95" stroke="#111" stroke-width="3" stroke-linecap="round"/>
      </g>
    </svg>
  </div>

  <p class="progress-text">excavation in progress...</p>

  <!-- ------------------------------------------------------------- -->
  <!-- SPOTIFY PROFILE & PLAYLIST WIDGET -->
  <!-- ------------------------------------------------------------- -->
  <div class="spotify-widget" id="spotify-widget">
    <div class="spotify-header">
      <a href="https://open.spotify.com/user/31eggmwgwd6b5f4672kiiveoehya" target="_blank" rel="noopener noreferrer" class="spotify-brand" title="Open Spotify Profile">
        <!-- Spotify Icon SVG (no emojis) -->
        <svg class="w-5 h-5" width="20" height="20" viewBox="0 0 24 24" fill="#1ed760">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.516 17.307c-.217.355-.678.47-1.033.253-2.83-1.73-6.393-2.12-10.59-1.163-.404.093-.807-.16-.9-.564-.093-.404.16-.807.564-.9 4.582-1.047 8.528-.607 11.706 1.341.355.217.47.678.253 1.033zm1.472-3.268c-.273.443-.853.585-1.296.312-3.238-1.99-8.175-2.566-12.006-1.402-.498.151-1.026-.135-1.177-.633-.151-.498.135-1.026.633-1.177 4.382-1.33 9.824-.69 13.534 1.594.443.273.585.853.312 1.306zm.126-3.41c-3.883-2.306-10.287-2.518-13.992-1.393-.596.18-1.229-.158-1.41-.754-.18-.596.158-1.229.754-1.41 4.256-1.292 11.317-1.043 15.792 1.614.536.318.712 1.01.394 1.546-.318.536-1.01.712-1.538.397z"/>
        </svg>
        <span>Olena's Spotify</span>
      </a>
      <button class="toggle-btn" id="spotify-toggle" aria-label="Toggle Player">_</button>
    </div>

    <div class="spotify-body" id="spotify-body">
      <!-- Spotify Playlist Embed -->
      <iframe
        style="border-radius: 12px; margin-top: 6px;"
        src="https://open.spotify.com/embed/playlist/49t7VWJc1n3WBnu5147AyR?utm_source=generator&theme=0"
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        title="alt current - Spotify"
      ></iframe>

      <div class="playlist-tags">
        <a href="https://open.spotify.com/playlist/49t7VWJc1n3WBnu5147AyR" target="_blank" rel="noopener noreferrer" class="playlist-pill">alt current (326)</a>
        <a href="https://open.spotify.com/user/31eggmwgwd6b5f4672kiiveoehya" target="_blank" rel="noopener noreferrer" class="playlist-pill">_ua</a>
        <a href="https://open.spotify.com/user/31eggmwgwd6b5f4672kiiveoehya" target="_blank" rel="noopener noreferrer" class="playlist-pill">qui(e)t(e)</a>
        <a href="https://open.spotify.com/user/31eggmwgwd6b5f4672kiiveoehya" target="_blank" rel="noopener noreferrer" class="playlist-pill">not qui(e)t(e)</a>
      </div>
    </div>
  </div>

  <script>
    // Dirt particles
    const container = document.getElementById('particles');
    const configs = [
      { tx: '-60px', ty: '-80px', delay: '0s',    dur: '0.8s' },
      { tx:  '70px', ty: '-60px', delay: '0.15s', dur: '0.7s' },
      { tx: '-40px', ty: '-90px', delay: '0.3s',  dur: '0.9s' },
      { tx:  '50px', ty: '-75px', delay: '0.1s',  dur: '0.75s' },
      { tx: '-80px', ty: '-50px', delay: '0.25s', dur: '0.85s' },
      { tx:  '30px', ty: '-95px', delay: '0.4s',  dur: '0.65s' },
      { tx: '-20px', ty: '-70px', delay: '0.05s', dur: '0.95s' },
      { tx:  '80px', ty: '-40px', delay: '0.35s', dur: '0.7s'  },
    ];
    if (container) {
      configs.forEach(({ tx, ty, delay, dur }) => {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.setProperty('--tx', tx);
        p.style.setProperty('--ty', ty);
        p.style.setProperty('--delay', delay);
        p.style.setProperty('--dur', dur);
        const shade = Math.floor(Math.random() * 40 + 70);
        p.style.background = `rgb(${shade + 20}, ${shade - 20}, 0)`;
        container.appendChild(p);
      });
    }

    // Progress updates
    setTimeout(() => {
      const msg = document.querySelector('.progress-text');
      if (msg) msg.textContent = "almost through...";
    }, 5000);
    setTimeout(() => {
      const msg = document.querySelector('.progress-text');
      if (msg) msg.textContent = "she's fine :)";
    }, 10000);

    // -------------------------------------------------------------
    // Interactive Leucauge Venusta Bungee Physics
    // -------------------------------------------------------------
    const spider = document.getElementById('spider');
    const thread = document.getElementById('spider-thread');
    const status = document.getElementById('spider-status');
    let isBungee = false;

    if (spider && thread && status) {
      spider.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isBungee) return;
        isBungee = true;

        status.textContent = "wheee! (bungee jump)";
        status.style.color = "#f97316";

        // Drop down on silk
        thread.style.height = '320px';
        spider.style.transform = 'translateY(40px) rotate(15deg)';

        setTimeout(() => {
          spider.style.transform = 'translateY(-15px) rotate(-10deg)';
        }, 350);

        setTimeout(() => {
          // Reel back up
          thread.style.height = '140px';
          spider.style.transform = 'translateY(0) rotate(0deg)';
          status.textContent = "Leucauge venusta (click!)";
          status.style.color = "#34d399";
          isBungee = false;
        }, 900);
      });
    }

    // -------------------------------------------------------------
    // Interactive Silk Canvas (Click to shoot silk strand)
    // -------------------------------------------------------------
    const canvas = document.getElementById('silk-canvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const resize = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
      resize();
      window.addEventListener('resize', resize);

      interface SilkLine {
        startX: number;
        startY: number;
        targetX: number;
        targetY: number;
        progress: number;
        alpha: number;
      }
      const lines: SilkLine[] = [];

      canvas.addEventListener('click', (e) => {
        if (!spider) return;
        const rect = spider.getBoundingClientRect();
        const startX = rect.left + rect.width / 2;
        const startY = rect.bottom;

        lines.push({
          startX,
          startY,
          targetX: e.clientX,
          targetY: e.clientY,
          progress: 0,
          alpha: 1
        });
      });

      function animateLines() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = lines.length - 1; i >= 0; i--) {
          const l = lines[i];
          l.progress = Math.min(1, l.progress + 0.08);
          if (l.progress >= 1) {
            l.alpha -= 0.015;
          }

          if (l.alpha <= 0) {
            lines.splice(i, 1);
            continue;
          }

          const currentX = l.startX + (l.targetX - l.startX) * l.progress;
          const currentY = l.startY + (l.targetY - l.startY) * l.progress;

          ctx.beginPath();
          ctx.moveTo(l.startX, l.startY);
          ctx.lineTo(currentX, currentY);
          ctx.strokeStyle = `rgba(167, 243, 208, ${l.alpha * 0.7})`;
          ctx.lineWidth = 1.5;
          ctx.shadowBlur = 6;
          ctx.shadowColor = 'rgba(52, 211, 153, 0.6)';
          ctx.stroke();

          // Sparkle at tip
          ctx.beginPath();
          ctx.arc(currentX, currentY, 3 * l.alpha, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${l.alpha})`;
          ctx.fill();
        }

        requestAnimationFrame(animateLines);
      }
      animateLines();
    }

    // -------------------------------------------------------------
    // Spotify Widget Collapse Toggle
    // -------------------------------------------------------------
    const widget = document.getElementById('spotify-widget');
    const toggle = document.getElementById('spotify-toggle');
    if (widget && toggle) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        widget.classList.toggle('collapsed');
        toggle.textContent = widget.classList.contains('collapsed') ? '+' : '_';
      });
    }
  </script>
</body>
</html>
