---
// Funny / Playful page - Leucauge venusta Orchard Orbweaver & Spotify
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Funny — Olena Teslia</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      width: 100%;
      background: linear-gradient(180deg, #1e3a2b 0%, #2e593d 30%, #688a5e 60%, #c49a6c 85%, #784c31 100%);
      font-family: 'Work Sans', sans-serif;
      overflow: hidden;
      user-select: none;
    }

    /* Sun */
    .sun {
      position: fixed;
      top: 6vh;
      left: 10vw;
      width: 70px;
      height: 70px;
      background: #fde047;
      border-radius: 50%;
      box-shadow: 0 0 45px 18px rgba(253, 224, 71, 0.4);
      animation: sunPulse 4s ease-in-out infinite alternate;
      z-index: 1;
    }
    @keyframes sunPulse {
      from { box-shadow: 0 0 45px 18px rgba(253, 224, 71, 0.4); }
      to   { box-shadow: 0 0 65px 28px rgba(253, 224, 71, 0.6); }
    }

    /* Ground & Grass */
    .ground {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 30vh;
      background: #5c3822;
      border-radius: 50% 50% 0 0 / 8% 8% 0 0;
      z-index: 3;
    }
    .grass {
      position: fixed;
      bottom: 28vh;
      left: 0;
      right: 0;
      height: 5vh;
      background: #15803d;
      border-radius: 50% 50% 0 0 / 40% 40% 0 0;
      z-index: 3;
    }

    /* New York City Skyscrapers Background */
    .nyc-skyline-bg {
      position: fixed;
      bottom: 28vh;
      left: 0;
      width: 100vw;
      height: 25vh;
      z-index: 2;
      pointer-events: none;
      overflow: hidden;
    }
    .nyc-skyline-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center bottom;
      opacity: 0.8;
      filter: contrast(1.15) brightness(0.78);
    }

    /* The Hole */
    .hole-wrapper {
      position: fixed;
      bottom: 26vh;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 3;
    }

    .hole {
      width: 80px;
      height: 0;
      background: #140702;
      border-radius: 50%;
      animation: digHole 3s ease-in forwards;
      animation-delay: 0.5s;
      box-shadow: inset 0 10px 20px rgba(0,0,0,0.8);
    }
    @keyframes digHole {
      0%   { width: 30px; height: 0px; }
      30%  { width: 70px; height: 20px; }
      60%  { width: 85px; height: 50px; }
      100% { width: 90px; height: 90px; }
    }

    /* Dirt Pile */
    .pile {
      position: fixed;
      bottom: 29.5vh;
      left: calc(50% + 55px);
      width: 0;
      height: 0;
      background: #3e1f0e;
      border-radius: 50% 50% 0 0;
      animation: growPile 3s ease-in forwards;
      animation-delay: 0.5s;
      z-index: 3;
    }
    @keyframes growPile {
      0%   { width: 0px;  height: 0px; }
      40%  { width: 40px; height: 20px; }
      100% { width: 65px; height: 40px; }
    }

    /* Stickman */
    .stickman-wrap {
      position: fixed;
      bottom: calc(29vh - 10px);
      left: calc(50% - 70px);
      z-index: 4;
      animation: stickmanSink 3s ease-in forwards;
      animation-delay: 0.5s;
    }
    @keyframes stickmanSink {
      0%   { transform: translateY(0); }
      50%  { transform: translateY(8px); }
      100% { transform: translateY(18px); }
    }

    .stickman {
      animation: digBody 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      transform-origin: 30px 65px;
    }
    @keyframes digBody {
      0%   { transform: translate(3px, -4px) rotate(-14deg); }
      25%  { transform: translate(-8px, 6px) rotate(24deg); }
      45%  { transform: translate(-3px, 4px) rotate(12deg); }
      65%  { transform: translate(6px, -6px) rotate(-22deg); }
      85%  { transform: translate(4px, -3px) rotate(-8deg); }
      100% { transform: translate(3px, -4px) rotate(-14deg); }
    }

    .arm-right {
      animation: armDig 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      transform-origin: 30px 42px;
    }
    @keyframes armDig {
      0%   { transform: rotate(-70deg) translate(-2px, -4px); }
      25%  { transform: rotate(55deg) translate(8px, 10px); }
      45%  { transform: rotate(20deg) translate(4px, 5px); }
      65%  { transform: rotate(-105deg) translate(-8px, -10px); }
      85%  { transform: rotate(-50deg) translate(-2px, -2px); }
      100% { transform: rotate(-70deg) translate(-2px, -4px); }
    }

    .arm-left {
      animation: armDig2 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      transform-origin: 30px 42px;
    }
    @keyframes armDig2 {
      0%   { transform: rotate(40deg) translate(2px, 2px); }
      25%  { transform: rotate(-65deg) translate(-6px, -6px); }
      45%  { transform: rotate(-25deg) translate(-2px, -2px); }
      65%  { transform: rotate(70deg) translate(8px, 8px); }
      85%  { transform: rotate(20deg) translate(2px, 0); }
      100% { transform: rotate(40deg) translate(2px, 2px); }
    }

    .leg-right {
      animation: legR 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      transform-origin: 30px 70px;
    }
    @keyframes legR {
      0%   { transform: rotate(8deg) scaleY(1); }
      25%  { transform: rotate(-16deg) scaleY(0.9); }
      45%  { transform: rotate(-10deg) scaleY(0.92); }
      65%  { transform: rotate(18deg) scaleY(1.04); }
      100% { transform: rotate(8deg) scaleY(1); }
    }

    .leg-left {
      animation: legL 1.1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      transform-origin: 30px 70px;
    }
    @keyframes legL {
      0%   { transform: rotate(-8deg) scaleY(0.95); }
      25%  { transform: rotate(18deg) scaleY(0.88); }
      45%  { transform: rotate(12deg) scaleY(0.9); }
      65%  { transform: rotate(-20deg) scaleY(1.02); }
      100% { transform: rotate(-8deg) scaleY(0.95); }
    }

    /* Particles */
    .particles {
      position: fixed;
      bottom: 30vh;
      left: 50%;
      pointer-events: none;
      z-index: 4;
    }
    .particle {
      position: absolute;
      width: 8px;
      height: 8px;
      background: #5c3822;
      border-radius: 50%;
      animation: flyDirt var(--dur) ease-out infinite;
      animation-delay: var(--delay);
      opacity: 0;
    }
    @keyframes flyDirt {
      0%   { transform: translate(0, 0) scale(1); opacity: 1; }
      100% { transform: translate(var(--tx), var(--ty)) scale(0.2); opacity: 0; }
    }

    /* Back Button */
    .back {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      font-family: 'Work Sans', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: #e2e8f0;
      background: rgba(8, 13, 10, 0.6);
      padding: 6px 14px;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.15);
      backdrop-blur: 8px;
      text-decoration: none;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: all 0.2s ease;
      z-index: 50;
    }
    .back:hover {
      background: rgba(5, 150, 105, 0.8);
      color: #ffffff;
      border-color: #34d399;
    }

    /* Construction Tape Strips */
    .construction-tape {
      position: fixed;
      left: -10vw;
      width: 120vw;
      height: 48px;
      background: #facc15;
      color: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Work Sans', sans-serif;
      font-weight: 800;
      font-size: clamp(0.95rem, 2.2vw, 1.5rem);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
      border-top: 4px dashed #000;
      border-bottom: 4px dashed #000;
      pointer-events: none;
      z-index: 30;
      overflow: hidden;
      white-space: nowrap;
    }

    .tape-top {
      top: 24vh;
      transform: rotate(-4.5deg);
    }

    .tape-bottom {
      bottom: 22vh;
      transform: rotate(3.5deg);
    }

    .tape-track {
      display: flex;
      gap: 2.5rem;
      align-items: center;
    }

    .hazard {
      color: #111;
      opacity: 0.7;
      letter-spacing: 0.25em;
      font-weight: 900;
    }

    /* Progress Text */
    .progress-text {
      position: fixed;
      bottom: 12vh;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Work Sans', sans-serif;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.8);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 10;
    }

    /* ------------------------------------------------------------- */
    /* LEUCAUGE VENUSTA (ORCHID ORBWEAVER) SPIDER & WEB INTERACTION */
    /* ------------------------------------------------------------- */
    .web-container {
      position: fixed;
      top: 0;
      right: 0;
      width: 320px;
      height: 320px;
      pointer-events: none;
      z-index: 15;
    }

    .spider-unit {
      position: fixed;
      top: 0;
      right: 18vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      z-index: 45;
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .silk-thread {
      width: 1.5px;
      height: 140px;
      background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(167,243,208,0.9) 100%);
      box-shadow: 0 0 8px rgba(16,185,129,0.5);
      transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .spider-body-svg {
      width: 54px;
      height: 64px;
      filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5));
      transition: transform 0.2s ease;
    }
    .spider-unit:hover .spider-body-svg {
      transform: scale(1.1);
    }

    .spider-tag {
      margin-top: 6px;
      background: rgba(8,13,10,0.85);
      color: #34d399;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 3px 8px;
      border-radius: 12px;
      border: 1px solid rgba(52,211,153,0.4);
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease;
      min-height: 18px;
    }

    /* Interactive Silk Canvas */
    #silk-canvas {
      position: fixed;
      inset: 0;
      pointer-events: auto;
      z-index: 12;
    }

    /* ------------------------------------------------------------- */
    /* SPOTIFY PROFILE WIDGET */
    /* ------------------------------------------------------------- */
    .spotify-widget {
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      z-index: 45;
      background: rgba(8, 13, 10, 0.9);
      border: 1px solid rgba(52, 211, 153, 0.35);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      border-radius: 16px;
      padding: 12px;
      width: 320px;
      backdrop-filter: blur(12px);
      transition: width 0.3s ease, padding 0.3s ease, border-radius 0.3s ease;
      will-change: transform;
    }

    .spotify-widget.bouncing-around {
      animation: widgetBounceJump 0.9s cubic-bezier(0.28, 0.84, 0.42, 1);
    }

    @keyframes widgetBounceJump {
      0% {
        transform: translate(var(--base-x, 0px), var(--base-y, 0px)) scale(1, 1) rotate(0deg);
      }
      15% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px) * 0.2), calc(var(--base-y, 0px) - 8px)) scale(1.1, 0.9) rotate(calc(var(--jump-rot, 0deg) * 0.3));
      }
      40% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px) * 0.6), calc(var(--base-y, 0px) + var(--jump-y, -45px))) scale(0.9, 1.12) rotate(var(--jump-rot, 0deg));
      }
      65% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px)), calc(var(--base-y, 0px) + 5px)) scale(1.12, 0.88) rotate(calc(var(--jump-rot, 0deg) * -0.4));
      }
      80% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px)), calc(var(--base-y, 0px) - 10px)) scale(0.95, 1.05) rotate(calc(var(--jump-rot, 0deg) * 0.2));
      }
      92% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px)), calc(var(--base-y, 0px) + 2px)) scale(1.02, 0.98) rotate(0deg);
      }
      100% {
        transform: translate(calc(var(--base-x, 0px) + var(--jump-x, 0px)), calc(var(--base-y, 0px) + var(--jump-y-target, 0px))) scale(1, 1) rotate(0deg);
      }
    }

    .spotify-widget.collapsed {
      width: auto;
      padding: 8px 14px;
      border-radius: 24px;
    }

    .spotify-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .spotify-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 700;
    }
    .spotify-brand:hover {
      color: #1ed760;
    }

    .toggle-btn {
      background: rgba(255,255,255,0.1);
      border: none;
      color: #cbd5e1;
      padding: 2px 8px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.75rem;
      font-family: inherit;
    }
    .toggle-btn:hover {
      background: rgba(255,255,255,0.2);
      color: #fff;
    }

    .spotify-body {
      margin-top: 10px;
    }
    .spotify-widget.collapsed .spotify-body {
      display: none;
    }

    .playlist-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 8px;
    }
    .playlist-pill {
      font-size: 0.68rem;
      padding: 2px 7px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.15);
      color: #6ee7b7;
      border: 1px solid rgba(16, 185, 129, 0.3);
      text-decoration: none;
      transition: all 0.15s;
    }
    .playlist-pill:hover {
      background: rgba(16, 185, 129, 0.35);
      color: #fff;
    }

    /* Building Cars & Bricks */
    .building-car {
      filter: drop-shadow(0 4px 6px rgba(0,0,0,0.35));
      cursor: pointer;
      transition: transform 0.2s ease;
      user-select: none;
    }
    .building-car:hover {
      transform: scale(1.05);
    }
    .car-bounce {
      animation: carHop 0.4s ease;
    }
    @keyframes carHop {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px) rotate(-2deg); }
    }

    .car-bulldozer-wrap {
      position: fixed;
      bottom: calc(28vh - 12px);
      left: calc(50% - 310px);
      z-index: 5;
    }

    .car-dumptruck-wrap {
      position: fixed;
      bottom: calc(28vh - 14px);
      left: calc(50% + 180px);
      z-index: 5;
    }

    .brick-stack-wrap {
      position: fixed;
      bottom: calc(28vh - 2px);
      left: calc(50% - 165px);
      z-index: 5;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    .brick-pile-wrap {
      position: fixed;
      bottom: calc(28vh - 2px);
      left: calc(50% + 125px);
      z-index: 5;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    @media (max-width: 768px) {
      .car-bulldozer-wrap { left: 2vw; transform: scale(0.85); transform-origin: bottom left; }
      .car-dumptruck-wrap { left: auto; right: 2vw; transform: scale(0.85); transform-origin: bottom right; }
      .brick-stack-wrap { display: none; }
      .brick-pile-wrap { left: calc(50% + 65px); transform: scale(0.85); }
    }

    @media (max-width: 640px) {
      .spider-unit { right: 8vw; }
      .spotify-widget {
        bottom: 0.75rem;
        left: 0.75rem;
        right: 0.75rem;
        width: auto;
      }
    }
  </style>
</head>
<body>

  <!-- Interactive Silk Canvas for Click-to-Spin web threads -->
  <canvas id="silk-canvas"></canvas>

  <!-- Orchard Orbweb in upper right corner -->
  <svg class="web-container" viewBox="0 0 300 300" fill="none" stroke="rgba(255,255,255,0.25)">
    <!-- Radial structural threads -->
    <line x1="300" y1="0" x2="20" y2="280" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="60" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="140" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="220" y2="300" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="0" y2="180" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    <line x1="300" y1="0" x2="0" y2="90" stroke-width="1.2" stroke="rgba(255,255,255,0.35)" />
    
    <!-- Concentric spiral loops -->
    <path d="M 120 20 A 180 180 0 0 0 280 180" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 80 40 A 220 220 0 0 0 260 220" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 40 70 A 260 260 0 0 0 230 260" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />
    <path d="M 10 110 A 290 290 0 0 0 200 290" stroke-width="0.9" stroke="rgba(167,243,208,0.35)" fill="none" />

    <!-- Dewdrops on web nodes -->
    <circle cx="210" cy="110" r="2.5" fill="#a7f3d0" opacity="0.8"/>
    <circle cx="170" cy="150" r="3" fill="#ffffff" opacity="0.9"/>
    <circle cx="120" cy="190" r="2.5" fill="#a7f3d0" opacity="0.7"/>
    <circle cx="240" cy="80" r="2" fill="#ffffff" opacity="0.8"/>
  </svg>

  <!-- Interactive Leucauge Venusta (Orchard Orbweaver) Spider Unit -->
  <div class="spider-unit" id="spider" title="Leucauge venusta">
    <div class="silk-thread" id="spider-thread"></div>
    
    <!-- Anatomically themed Leucauge venusta SVG -->
    <svg class="spider-body-svg" viewBox="0 0 100 120">
      <!-- 8 Jointed Spider Legs (emerald / amber jointed) -->
      <g stroke="#a3e635" stroke-width="3" stroke-linecap="round" fill="none">
        <!-- Anterior Leg pair I -->
        <path d="M 45 40 Q 20 15 5 25" />
        <path d="M 55 40 Q 80 15 95 25" />
        <!-- Leg pair II -->
        <path d="M 43 45 Q 15 35 8 55" />
        <path d="M 57 45 Q 85 35 92 55" />
        <!-- Leg pair III -->
        <path d="M 44 52 Q 22 55 12 75" />
        <path d="M 56 52 Q 78 55 88 75" />
        <!-- Posterior Leg pair IV -->
        <path d="M 45 58 Q 25 85 18 105" />
        <path d="M 55 58 Q 75 85 82 105" />
      </g>
      
      <!-- Cephalothorax (amber / dark olive) -->
      <ellipse cx="50" cy="48" rx="8" ry="11" fill="#14532d" stroke="#10b981" stroke-width="1.5" />
      
      <!-- Chelicerae / Pedipalps -->
      <circle cx="48" cy="38" r="2" fill="#facc15"/>
      <circle cx="52" cy="38" r="2" fill="#facc15"/>

      <!-- Abdomen (Leucauge Venusta: bright metallic emerald, silver dorsal stripes, fiery ventral orange spots) -->
      <ellipse cx="50" cy="74" rx="14" ry="22" fill="#059669" stroke="#34d399" stroke-width="2" />
      
      <!-- Silver pearlescent dorsal bands -->
      <path d="M 42 56 Q 44 74 42 92" stroke="#f1f5f9" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <path d="M 58 56 Q 56 74 58 92" stroke="#f1f5f9" stroke-width="2.5" fill="none" stroke-linecap="round" />
      <line x1="50" y1="58" x2="50" y2="90" stroke="#047857" stroke-width="1.5" />

      <!-- Iconic Leucauge Venusta ventral fiery flame-orange marking -->
      <circle cx="50" cy="85" r="4.5" fill="#f97316" stroke="#ea580c" stroke-width="1.5" />
      <circle cx="50" cy="85" r="2" fill="#fde047" />
    </svg>

    <span class="spider-tag" id="spider-status"></span>
  </div>

  <!-- Construction Tape Strips -->
  <div class="construction-tape tape-top" aria-hidden="true">
    <div class="tape-track">
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
      <span class="hazard">///</span>
      <span>[under development...]</span>
    </div>
  </div>

  <div class="construction-tape tape-bottom" aria-hidden="true">
    <div class="tape-track">
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
      <span class="hazard">///</span>
      <span>currently some AI slope .^.</span>
    </div>
  </div>

  <!-- Navigation -->
  <a href="/" class="back">← back</a>

  <!-- Sun -->
