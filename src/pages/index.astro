---
// Landing page - Leucauge venusta colorscheme
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Olena Teslia</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      width: 100%;
      background: #080d0a; /* Leucauge venusta deep ebony */
      color: #e2e8f0;     /* Leucauge venusta metallic pearl silver */
      font-family: 'Work Sans', sans-serif;
      overflow: hidden;
    }

    .container {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .star {
      position: absolute;
      border-radius: 50%;
      background: #e2e8f0;
      animation: twinkle var(--d, 3s) ease-in-out infinite alternate;
    }
    @keyframes twinkle {
      from { opacity: 0.1; }
      to   { opacity: 0.7; }
    }

    .choices {
      display: flex;
      gap: 2rem;
      position: relative;
      z-index: 1;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 180px;
      height: 56px;
      border-radius: 8px;
      font-family: 'Work Sans', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-decoration: none;
      cursor: pointer;
      border: 1.5px solid;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
      background: transparent;
    }

    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    /* Leucauge venusta Orchard Emerald */
    .btn-tired {
      color: #34d399;
      border-color: #059669;
    }
    .btn-tired::before {
      background: rgba(5, 150, 105, 0.15);
    }
    .btn-tired:hover {
      color: #6ee7b7;
      border-color: #10b981;
      transform: translateY(-2px);
    }
    .btn-tired:hover::before {
      opacity: 1;
    }

    /* Leucauge venusta Ventral Flame Orange - equal visual weight, not highlighted */
    .btn-funny {
      color: #fb923c;
      border-color: #ea580c;
    }
    .btn-funny::before {
      background: rgba(234, 88, 12, 0.15);
    }
    .btn-funny:hover {
      color: #fdba74;
      border-color: #f97316;
      transform: translateY(-2px);
    }
    .btn-funny:hover::before {
      opacity: 1;
    }

    .btn span { position: relative; z-index: 1; }

    @media (max-width: 480px) {
      .choices { flex-direction: column; gap: 1rem; }
      .btn { width: 220px; }
    }

    .footer {
      position: fixed;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      color: #64748b;
      font-family: 'Work Sans', sans-serif;
      text-transform: uppercase;
      z-index: 1;
      user-select: none;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div class="stars" id="stars"></div>
  <div class="container">
    <div class="choices">
      <a href="/home" class="btn btn-tired"><span>tired</span></a>
      <a href="/playful" class="btn btn-funny"><span>funny</span></a>
    </div>
  </div>
  <footer class="footer">
    (c) Leucauge Venusta
  </footer>
  <script>
    const container = document.getElementById('stars');
    if (container) {
      for (let i = 0; i < 120; i++) {
        const star = document.createElement('div');
        star.className = 'star';
        const size = Math.random() * 2 + 0.5;
        star.style.cssText = `width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;--d:${(Math.random()*3+2).toFixed(1)}s;animation-delay:${(Math.random()*4).toFixed(1)}s;opacity:${Math.random()*0.4};`;
        container.appendChild(star);
      }
    }
  </script>
</body>
</html>
