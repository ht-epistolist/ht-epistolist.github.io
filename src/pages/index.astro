---
// Landing page - Leucauge venusta colorscheme
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      height: 100dvh;
      width: 100%;
      margin: 0;
      padding: 0;
      background: #080d0a; /* Leucauge venusta deep ebony */
      color: #e2e8f0;     /* Leucauge venusta metallic pearl silver */
      font-family: 'Work Sans', sans-serif;
      overflow: hidden;
      position: relative;
    }

    .stars {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .star {
      position: absolute;
      border-radius: 50%;
      background: #e2e8f0;
      animation: twinkle var(--d, 3s) ease-in-out infinite alternate;
    }
    @keyframes twinkle {
      from { opacity: 0.1; }
      to   { opacity: 0.7; }
    }

    /* Single container holding both buttons, dead-centered horizontally and vertically */
    .landing-container {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      z-index: 10;
      margin: 0;
      padding: 0;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 360px;
      height: 112px;
      border-radius: 16px;
      font-family: 'Work Sans', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-decoration: none;
      cursor: pointer;
      border: 3px solid;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
      background: transparent;
    }

    .btn::before {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    /* Leucauge venusta Orchard Emerald */
    .btn-tired {
      color: #34d399;
      border-color: #059669;
    }
    .btn-tired::before {
      background: rgba(5, 150, 105, 0.15);
    }
    .btn-tired:hover {
      color: #6ee7b7;
      border-color: #10b981;
      transform: translateY(-4px);
    }
    .btn-tired:hover::before {
      opacity: 1;
    }

    /* Leucauge venusta Ventral Flame Orange - equal visual weight, not highlighted */
    .btn-funny {
      color: #fb923c;
      border-color: #ea580c;
    }
    .btn-funny::before {
      background: rgba(234, 88, 12, 0.15);
    }
    .btn-funny:hover {
      color: #fdba74;
      border-color: #f97316;
      transform: translateY(-4px);
    }
    .btn-funny:hover::before {
      opacity: 1;
    }

    .btn span { position: relative; z-index: 1; }

    @media (max-width: 820px) {
      .landing-container {
        flex-direction: column;
        gap: 2rem;
      }
      .btn {
        width: min(85vw, 360px);
        height: 96px;
        font-size: 1.7rem;
      }
    }

    .footer {
      position: fixed;
      bottom: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      color: #64748b;
      font-family: 'Work Sans', sans-serif;
      text-transform: uppercase;
      z-index: 1;
      user-select: none;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div class="stars" id="stars"></div>

  <!-- Single centered container on the markup holding both buttons -->
  <div class="landing-container">
    <a href="/home" class="btn btn-tired"><span>tired</span></a>
    <a href="/funny" class="btn btn-funny"><span>funny</span></a>
  </div>

  <footer class="footer">
    (c) Leucauge Venusta
  </footer>

  <script>
    const container = document.getElementById('stars');
    if (container) {
      for (let i = 0; i < 120; i++) {
        const star = document.createElement('div');
        star.className = 'star';
        const size = Math.random() * 2 + 0.5;
        star.style.cssText = `width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;--d:${(Math.random()*3+2).toFixed(1)}s;animation-delay:${(Math.random()*4).toFixed(1)}s;opacity:${Math.random()*0.4};`;
        container.appendChild(star);
      }
    }
  </script>
</body>
</html>
