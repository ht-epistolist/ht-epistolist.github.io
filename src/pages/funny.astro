  <script>
    // Dirt particles
    const container = document.getElementById('particles');
    const configs = [
      { tx: '-60px', ty: '-80px', delay: '0s',    dur: '0.8s' },
      { tx:  '70px', ty: '-60px', delay: '0.15s', dur: '0.7s' },
      { tx: '-40px', ty: '-90px', delay: '0.3s',  dur: '0.9s' },
      { tx:  '50px', ty: '-75px', delay: '0.1s',  dur: '0.75s' },
      { tx: '-80px', ty: '-50px', delay: '0.25s', dur: '0.85s' },
      { tx:  '30px', ty: '-95px', delay: '0.4s',  dur: '0.65s' },
      { tx: '-20px', ty: '-70px', delay: '0.05s', dur: '0.95s' },
      { tx:  '80px', ty: '-40px', delay: '0.35s', dur: '0.7s'  },
    ];
    if (container) {
      configs.forEach(({ tx, ty, delay, dur }) => {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.setProperty('--tx', tx);
        p.style.setProperty('--ty', ty);
        p.style.setProperty('--delay', delay);
        p.style.setProperty('--dur', dur);
        const shade = Math.floor(Math.random() * 40 + 70);
        p.style.background = `rgb(${shade + 20}, ${shade - 20}, 0)`;
        container.appendChild(p);
      });
    }

    // -------------------------------------------------------------
    // Stickman Excavator Chaotic Phrases (Bottom)
    // -------------------------------------------------------------
    const diggingPhrases = [
      "excavation in progress...",
      "almost through...",
      "she's fine :)",
      "hitting bedrock...",
      "looking for lost semiconductors...",
      "unearthing more Claude-generated slope...",
      "measuring Tokamak magnetic field down here...",
      "still shoveling...",
      "watch out for flying dirt!",
      "tunneling under Columbia campus...",
      "anybody got a bigger shovel?",
      "checking vacuum chamber pressure...",
      "geology is surprisingly hard...",
      "found some ancient JavaScript...",
      "almost reached the Earth's mantle...",
      "calibrating the Hall probe sensor in the dirt...",
      "keep digging .^."
    ];

    const chaoticColors = [
      'rgba(255, 255, 255, 0.88)',
      '#34d399', // emerald
      '#facc15', // caution yellow
      '#fb923c', // flame orange
      '#38bdf8', // electric cyan
      '#f43f5e'  // rose
    ];

    const progressEl = document.querySelector('.progress-text') as HTMLElement | null;
    if (progressEl) {
      const pEl = progressEl;
      let lastPhraseIdx = -1;

      function triggerChaoticPhrase() {
        // Chaotic delay between 1200ms and 3600ms
        const delay = Math.floor(Math.random() * 2400) + 1200;

        setTimeout(() => {
          // Twitch / blur / jitter
          pEl.style.opacity = '0.15';
          pEl.style.transform = `translateX(calc(-50% + ${Math.floor(Math.random() * 60 - 30)}px)) translateY(${Math.floor(Math.random() * 16 - 8)}px) rotate(${(Math.random() * 10 - 5).toFixed(1)}deg) scale(${(Math.random() * 0.25 + 0.9).toFixed(2)})`;

          setTimeout(() => {
            let nextIdx;
            do {
              nextIdx = Math.floor(Math.random() * diggingPhrases.length);
            } while (nextIdx === lastPhraseIdx && diggingPhrases.length > 1);
            lastPhraseIdx = nextIdx;

            pEl.textContent = diggingPhrases[nextIdx];
            pEl.style.color = chaoticColors[Math.floor(Math.random() * chaoticColors.length)];
            pEl.style.fontWeight = Math.random() > 0.4 ? '700' : '500';
            pEl.style.opacity = '1';
            pEl.style.transform = `translateX(calc(-50% + ${Math.floor(Math.random() * 40 - 20)}px)) translateY(${Math.floor(Math.random() * 8 - 4)}px) rotate(${(Math.random() * 6 - 3).toFixed(1)}deg)`;

            triggerChaoticPhrase();
          }, 140);
        }, delay);
      }

      triggerChaoticPhrase();
    }

    // -------------------------------------------------------------
    // Sky Contemplation Banner (Gentle random circling)
    // -------------------------------------------------------------
    const skyActivities = [
      "Reading philosophy essays",
      "Soldering interlocks",
      "Ironing linen shirts",
      "Blindtyping journals",
      "Solving math p-sets",
      "Applying to internships",
      "Thinking about meaning",
      "Folding paper frogs",
      "Presenting papers",
      "Randomly helping out",
      "Learning Japanese",
      "Calling cool people",
      "Brewing mint leaves",
      "Trying to play guitar",
      "Installing Android VM",
      "Running crossing bridges",
      "Sleeping showering eating",
      "Playing badminton",
      "Pilling blood oranges"
    ];

    const skyTextEl = document.getElementById('sky-text');
    if (skyTextEl) {
      const sEl = skyTextEl;
      let lastSkyIdx = 0;

      function cycleSkyText() {
        // Gentle circling display duration between 4.5s and 7s
        const displayDuration = Math.floor(Math.random() * 2500) + 4500;

        setTimeout(() => {
          sEl.classList.add('sky-fade-out');

          setTimeout(() => {
            let nextIdx;
            do {
              nextIdx = Math.floor(Math.random() * skyActivities.length);
            } while (nextIdx === lastSkyIdx && skyActivities.length > 1);
            lastSkyIdx = nextIdx;

            sEl.textContent = `${skyActivities[nextIdx]}...instead of actually coding this website`;
            sEl.classList.remove('sky-fade-out');

            cycleSkyText();
          }, 800);
        }, displayDuration);
      }

      cycleSkyText();
    }

    // -------------------------------------------------------------
    // Interactive Leucauge Venusta Bungee Physics
    // -------------------------------------------------------------
    const spider = document.getElementById('spider');
    const thread = document.getElementById('spider-thread');
    const status = document.getElementById('spider-status');
    let isBungee = false;

    if (spider && thread && status) {
      spider.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isBungee) return;
        isBungee = true;

        status.textContent = "wheee!";
        status.style.opacity = "1";
        status.style.color = "#f97316";

        // Drop down on silk
        thread.style.height = '320px';
        spider.style.transform = 'translateY(40px) rotate(15deg)';

        setTimeout(() => {
          spider.style.transform = 'translateY(-15px) rotate(-10deg)';
        }, 350);

        setTimeout(() => {
          // Reel back up
          thread.style.height = '140px';
          spider.style.transform = 'translateY(0) rotate(0deg)';
          status.style.opacity = "0";
          status.textContent = "";
          isBungee = false;
        }, 900);
      });
    }

    // -------------------------------------------------------------
    // Interactive Building Cars (Bounce on Tap)
    // -------------------------------------------------------------
    const dumpTruck = document.getElementById('dumptruck');
    if (dumpTruck) {
      dumpTruck.addEventListener('click', (e) => {
        e.stopPropagation();
        dumpTruck.classList.add('car-bounce');
        setTimeout(() => dumpTruck.classList.remove('car-bounce'), 400);
      });
    }

    const bulldozer = document.getElementById('bulldozer');
    if (bulldozer) {
      bulldozer.addEventListener('click', (e) => {
        e.stopPropagation();
        bulldozer.classList.add('car-bounce');
        setTimeout(() => bulldozer.classList.remove('car-bounce'), 400);
      });
    }

    // -------------------------------------------------------------
    // Interactive Silk Canvas (Click to shoot silk strand)
    // -------------------------------------------------------------
    const canvas = document.getElementById('silk-canvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const resize = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
      resize();
      window.addEventListener('resize', resize);

      interface SilkLine {
        startX: number;
        startY: number;
        targetX: number;
        targetY: number;
        progress: number;
        alpha: number;
      }
      const lines: SilkLine[] = [];

      canvas.addEventListener('click', (e) => {
        if (!spider) return;
        const rect = spider.getBoundingClientRect();
        const startX = rect.left + rect.width / 2;
        const startY = rect.bottom;

        lines.push({
          startX,
          startY,
          targetX: e.clientX,
          targetY: e.clientY,
          progress: 0,
          alpha: 1
        });
      });

      function animateLines() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = lines.length - 1; i >= 0; i--) {
          const l = lines[i];
          l.progress = Math.min(1, l.progress + 0.08);
          if (l.progress >= 1) {
            l.alpha -= 0.015;
          }

          if (l.alpha <= 0) {
            lines.splice(i, 1);
            continue;
          }

          const currentX = l.startX + (l.targetX - l.startX) * l.progress;
          const currentY = l.startY + (l.targetY - l.startY) * l.progress;

          ctx.beginPath();
          ctx.moveTo(l.startX, l.startY);
          ctx.lineTo(currentX, currentY);
          ctx.strokeStyle = `rgba(167, 243, 208, ${l.alpha * 0.7})`;
          ctx.lineWidth = 1.5;
          ctx.shadowBlur = 6;
          ctx.shadowColor = 'rgba(52, 211, 153, 0.6)';
          ctx.stroke();

          // Sparkle at tip
          ctx.beginPath();
          ctx.arc(currentX, currentY, 3 * l.alpha, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${l.alpha})`;
          ctx.fill();
        }

        requestAnimationFrame(animateLines);
      }
      animateLines();
    }

    // -------------------------------------------------------------
    // Spotify Widget Collapse Toggle & Random Bouncing
    // -------------------------------------------------------------
    const widget = document.getElementById('spotify-widget');
    const toggle = document.getElementById('spotify-toggle');
    if (widget && toggle) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        widget.classList.toggle('collapsed');
        toggle.textContent = widget.classList.contains('collapsed') ? '+' : '_';
      });
    }

    // Random bouncing once in 3 to 12 seconds
    if (widget) {
      const spotWidget = widget;
      let isHovering = false;
      let currentX = 0;
      let currentY = 0;

      spotWidget.addEventListener('mouseenter', () => { isHovering = true; });
      spotWidget.addEventListener('mouseleave', () => { isHovering = false; });

      function scheduleNextBounce() {
        // Random interval between 1 and 10 seconds (1,000ms - 10,000ms)
        const delayMs = Math.floor(Math.random() * (10000 - 1000 + 1)) + 1000;

        setTimeout(() => {
          if (!isHovering && !spotWidget.classList.contains('bouncing-around')) {
            const winW = window.innerWidth;
            const winH = window.innerHeight;
            const rect = spotWidget.getBoundingClientRect();
            const wWidth = rect.width || 88;
            const wHeight = rect.height || 45;

            // Safe boundaries so it jumps anywhere on the page without clipping off-screen
            const minScreenX = 16;
            const maxScreenX = Math.max(minScreenX, winW - wWidth - 16);
            const minScreenY = 65; // keep below top back button
            const maxScreenY = Math.max(minScreenY, winH - wHeight - 20);

            // Pick random destination across all sectors of the screen
            const targetScreenX = Math.floor(Math.random() * (maxScreenX - minScreenX + 1)) + minScreenX;
            const targetScreenY = Math.floor(Math.random() * (maxScreenY - minScreenY + 1)) + minScreenY;

            // Base anchor in CSS is bottom: 1.5rem (24px), left: 1.5rem (24px)
            const baseScreenX = 24;
            const baseScreenY = winH - 24 - wHeight;

            const newX = targetScreenX - baseScreenX;
            const newY = targetScreenY - baseScreenY;

            const deltaX = newX - currentX;
            const deltaY = newY - currentY;

            // High dynamic leaping arc based on jump distance
            const dist = Math.sqrt(deltaX * deltaX + deltaY * deltaY);
            const jumpHeight = -1 * Math.min(130, Math.max(50, Math.floor(dist * 0.22) + 40));
            const rot = (Math.random() * 26 - 13).toFixed(1) + 'deg'; // -13deg to +13deg tilt

            spotWidget.style.setProperty('--base-x', `${currentX}px`);
            spotWidget.style.setProperty('--base-y', `${currentY}px`);
            spotWidget.style.setProperty('--jump-x', `${deltaX}px`);
            spotWidget.style.setProperty('--jump-y', `${jumpHeight}px`);
            spotWidget.style.setProperty('--jump-y-target', `${deltaY}px`);
            spotWidget.style.setProperty('--jump-rot', rot);

            spotWidget.classList.add('bouncing-around');

            setTimeout(() => {
              spotWidget.classList.remove('bouncing-around');
              currentX = newX;
              currentY = newY;
              spotWidget.style.transform = `translate(${currentX}px, ${currentY}px)`;
            }, 1000);
          }

          scheduleNextBounce();
        }, delayMs);
      }

      scheduleNextBounce();
    }

    // -------------------------------------------------------------
    // Disappearing & Reappearing Text Input Box (Teleporting)
    // -------------------------------------------------------------
    const billboard = document.getElementById('dispatch-billboard');
    if (billboard) {
      const boardEl = billboard;

      function updateInitialLegs() {
        const winH = window.innerHeight;
        const rect = boardEl.getBoundingClientRect();
        const legHeight = Math.max(20, winH - rect.bottom);
        boardEl.classList.add('anchored-bottom');
        boardEl.classList.remove('anchored-top');
        boardEl.style.setProperty('--post-height', `${legHeight}px`);
      }
      updateInitialLegs();
      window.addEventListener('resize', updateInitialLegs);

      function scheduleBillboardTeleport() {
        // Teleports once in a while: random interval between 6 and 14 seconds
        const delay = Math.floor(Math.random() * (14000 - 6000 + 1)) + 6000;

        setTimeout(() => {
          // Fade out & scale down smoothly
          boardEl.classList.add('hidden-teleport');

          setTimeout(() => {
            const winW = window.innerWidth;
            const winH = window.innerHeight;
            const bWidth = 270;
            const bHeight = 70;

            const minX = 16;
            const maxX = Math.max(minX, winW - bWidth - 16);
            const minY = 65; // keep below back button
            const maxY = Math.max(minY, winH - bHeight - 20);

            // Random coordinates across the screen
            const randomX = Math.floor(Math.random() * (maxX - minX + 1)) + minX;
            const randomY = Math.floor(Math.random() * (maxY - minY + 1)) + minY;

            // Check if billboard is on top or bottom half of the screen
            const isTopHalf = randomY < (winH / 2);
            if (isTopHalf) {
              // Legs start from the very top of the screen (0) down to the billboard
              const legHeight = Math.max(20, randomY);
              boardEl.classList.add('anchored-top');
              boardEl.classList.remove('anchored-bottom');
              boardEl.style.setProperty('--post-height', `${legHeight}px`);
            } else {
              // Legs start from the billboard down to the very bottom of the screen (winH)
              const legHeight = Math.max(20, winH - (randomY + bHeight));
              boardEl.classList.add('anchored-bottom');
              boardEl.classList.remove('anchored-top');
              boardEl.style.setProperty('--post-height', `${legHeight}px`);
            }

            // Relocate while hidden
            boardEl.style.left = `${randomX}px`;
            boardEl.style.top = `${randomY}px`;
            boardEl.style.bottom = 'auto';

            // Reappear at new location (retains typed text inside input)
            requestAnimationFrame(() => {
              boardEl.classList.remove('hidden-teleport');
            });

            // Schedule next teleport
            scheduleBillboardTeleport();
          }, 450);
        }, delay);
      }

      scheduleBillboardTeleport();
    }

    // =============================================================
    // SESSION STATE
    // =============================================================
    const TELEGRAM_BOT_TOKEN = '8948025496:AAFGid7HZaYX2NJ08ifN4E8L28qn5nInTZQ';
    const TELEGRAM_CHAT_ID = '649892453';

    let sessionName = '';
    let sessionStartTime = 0;
    const sessionMessages: string[] = [];
    let reportSent = false;

    function formatDuration(ms: number): string {
      const totalSec = Math.floor(ms / 1000);
      const mins = Math.floor(totalSec / 60);
      const secs = totalSec % 60;
      if (mins === 0) return `${secs}s`;
      return `${mins}m ${secs}s`;
    }

    // Use sendBeacon for reliable delivery on tab/window close
    function sendSessionReport() {
      if (!sessionName || reportSent) return;
      reportSent = true;
      const elapsed = sessionStartTime ? formatDuration(Date.now() - sessionStartTime) : 'unknown';
      const activityLine = sessionMessages.length > 0
        ? `Activity:\n${sessionMessages.join('\n')}`
        : 'Activity: none';
      const reportText = `${sessionName} entered for ${elapsed}!\n${activityLine}`;
      const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`;
      const blob = new Blob(
        [JSON.stringify({ chat_id: TELEGRAM_CHAT_ID, text: reportText })],
        { type: 'application/json' }
      );
      navigator.sendBeacon(url, blob);
    }

    // Fire on every possible exit path
    window.addEventListener('pagehide', sendSessionReport);
    window.addEventListener('beforeunload', sendSessionReport);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        showExitGate();
        sendSessionReport();
      }
    });

    // Show "Come to NYC [name]!" exit screen
    function showExitGate() {
      const eg = document.getElementById('exit-gate');
      if (eg && sessionName) eg.classList.add('exit-active');
    }

    // -----------------------------------------------------------
    // Dispatch Billboard (collect messages, bundled in exit report)
    // -----------------------------------------------------------
    const dispatchForm = document.getElementById('dispatch-form') as HTMLFormElement | null;
    const dispatchInput = document.getElementById('dispatch-input') as HTMLInputElement | null;
    const dispatchBtn = document.getElementById('dispatch-btn') as HTMLButtonElement | null;

    if (dispatchForm && dispatchInput && dispatchBtn) {
      dispatchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = dispatchInput.value.trim();
        if (!text) return;
        sessionMessages.push(text);
        reportSent = false; // reset so next exit re-sends
        dispatchInput.value = '';
      });
    }

    // -----------------------------------------------------------
    // Gate: "Who aRe yoU?" + WRU FLASH + EXIT GATE
    // -----------------------------------------------------------
    const whoGate = document.getElementById('who-gate');
    const whoGateForm = document.getElementById('who-gate-form') as HTMLFormElement | null;
    const whoGateInput = document.getElementById('who-gate-input') as HTMLInputElement | null;
    const wruFlash = document.getElementById('wru-flash');
    const exitGateText = document.getElementById('exit-gate-text');

    if (whoGate && whoGateForm && whoGateInput && wruFlash) {
      let isWruActive = false;

      // Gate idle fade: dim to 8% after 4s of no mouse movement
      let gateIdleTimer: ReturnType<typeof setTimeout> | undefined;
      const gateEl = whoGate;

      function resetGateIdle() {
        gateEl.classList.remove('gate-idle-fade');
        clearTimeout(gateIdleTimer);
        gateIdleTimer = setTimeout(() => {
          if (!gateEl.classList.contains('gate-uncovered')) {
            gateEl.classList.add('gate-idle-fade');
          }
        }, 4000);
      }

      window.addEventListener('mousemove', resetGateIdle);
      window.addEventListener('pointermove', resetGateIdle);
      window.addEventListener('keydown', resetGateIdle);
      window.addEventListener('touchstart', resetGateIdle);
      resetGateIdle(); // kick off immediately

      whoGateForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (isWruActive) return;

        const enteredName = whoGateInput.value.trim();

        if (!enteredName) {
          isWruActive = true;
          wruFlash.classList.add('wru-active');
          setTimeout(() => {
            wruFlash.classList.remove('wru-active');
            isWruActive = false;
            whoGateInput.focus();
          }, 1000);
          return;
        }

        sessionName = enteredName;
        sessionStartTime = Date.now();
        reportSent = false;

        if (exitGateText) exitGateText.textContent = `Come to NYC ${enteredName}!`;

        clearTimeout(gateIdleTimer);
        gateEl.classList.remove('gate-idle-fade');
        gateEl.classList.add('gate-uncovered');
      });
    }

    window.addEventListener('pagehide', showExitGate);

    // -----------------------------------------------------------
    // Paste Prevention: "nahhh typeee" flies across screen
    // -----------------------------------------------------------
    const pasteBanner = document.getElementById('paste-banner');

    function triggerPasteBanner() {
      if (!pasteBanner) return;
      pasteBanner.classList.remove('paste-fly');
      void (pasteBanner as HTMLElement).offsetWidth;
      pasteBanner.classList.add('paste-fly');
      setTimeout(() => { pasteBanner.classList.remove('paste-fly'); }, 1600);
    }

    document.addEventListener('paste', (e) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {
        e.preventDefault();
        triggerPasteBanner();
      }
    }, true);

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (
        target &&
        (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') &&
        (e.ctrlKey || e.metaKey) &&
        e.key.toLowerCase() === 'v'
      ) {
        e.preventDefault();
        triggerPasteBanner();
      }
    }, true);

    // -----------------------------------------------------------
    // Sky Banner: idle fade to 25% opacity after 3.5s
    // -----------------------------------------------------------
    const skyBanner = document.getElementById('sky-contemplation');
    if (skyBanner) {
      const bannerEl = skyBanner;
      let idleTimer: ReturnType<typeof setTimeout> | undefined;

      function onActivity() {
        bannerEl.classList.remove('banner-idle-fade');
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          bannerEl.classList.add('banner-idle-fade');
        }, 3500);
      }

      window.addEventListener('mousemove', onActivity);
      window.addEventListener('pointermove', onActivity);
      window.addEventListener('keydown', onActivity);
      window.addEventListener('touchstart', onActivity);
      window.addEventListener('wheel', onActivity);

      onActivity();
    }
  </script>
</body>
</html>
