---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Olena Teslia | Home">
    <div class="flex flex-col md:flex-row gap-8 items-start mt-8">
        <div class="w-full md:w-2/3">
            <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4">
                Hi, I'm <span class="text-accent-green dark:text-accent-green-dark">Olena Teslia</span>.
            </h1>
            <p class="text-lg mb-2 font-heading text-slate-500 dark:text-slate-400 tracking-wide">
                Engineering. Research. Art. Volunteering.
            </p>
            <div class="prose dark:prose-invert prose-slate mb-6 max-w-none">
                <p>
                    I'm doing Electrical Engineering at Columbia University, interested in <strong>bioelectronics</strong>, <strong>robotics</strong>, and <strong>weird innovations</strong>, advancing in <strong>Math</strong>, <strong>Physics</strong>, and <strong>CS</strong>, as well as circuits and signals processing — and doing research at the Columbia Stellarator eXperiment.
                </p>
                <p>
                    I also practice Photography, <strong>Graphic Design</strong>, <strong>Drawing</strong>, and <strong>Creative Writing</strong>.
                </p>
            </div>
            <div class="prose dark:prose-invert prose-slate mb-8 max-w-none border-l-4 border-accent-orange pl-4">
                <p class="italic text-slate-600 dark:text-slate-400">
                    I'm open for a project to challenge my skills and views — ready to dedicate myself fully to extraordinary ideas through Engineering, Product Design, Product Management, Research, or other positions.
                </p>
            </div>

            <div class="flex flex-wrap gap-4 items-center">
                <a href="mailto:ht.epistolist@gmail.com" class="font-heading text-accent-green dark:text-accent-green-dark hover:underline font-semibold transition-colors">
                    ht.epistolist@gmail.com
                </a>
                <a href="/portfolio" class="px-6 py-2 border border-slate-300 dark:border-slate-700 rounded-lg font-bold hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                    View Portfolio
                </a>
                <a href="/career" class="px-6 py-2 bg-accent-orange hover:bg-accent-orange-dark text-white rounded-lg font-bold transition-colors">
                    Open to Work
                </a>
            </div>
        </div>
        
        <div class="w-full md:w-1/3 flex flex-col items-center justify-center md:pt-4">
            <div class="w-56 h-56 sm:w-64 sm:h-64 rounded-full overflow-hidden border-4 border-accent-green dark:border-accent-green-dark shadow-2xl transition-transform duration-300 hover:scale-105">
                <img src="/images/profile.jpg" alt="Olena Teslia Profile" class="w-full h-full object-cover" />
            </div>
        </div>
    </div>
</Layout>
