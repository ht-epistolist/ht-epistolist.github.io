---
import Layout from '../layouts/Layout.astro';
import PollComponent from '../components/PollComponent.astro';
---

<Layout title="Surveys & Contact | Olena Teslia">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <div id="contact" class="scroll-mt-24">
            <h1 class="text-4xl font-heading font-bold mb-4">Get In Touch</h1>
            <p class="mb-8 text-slate-600 dark:text-slate-300">
                Whether you want to request a cover letter, collaborate on a project, or just say hi, feel free to reach out using the form below.
            </p>
            
            <form id="contact-form" class="space-y-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-6 rounded-xl shadow-sm">
                <div>
                    <label for="name" class="block text-sm font-bold mb-1">Name</label>
                    <input type="text" id="name" name="name" required class="w-full px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-accent-green" placeholder="Your name">
                </div>
                <div>
                    <label for="email" class="block text-sm font-bold mb-1">Email</label>
                    <input type="email" id="email" name="email" required class="w-full px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-accent-green" placeholder="your.email@example.com">
                </div>
                <div>
                    <label for="message" class="block text-sm font-bold mb-1">Message</label>
                    <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-accent-green" placeholder="Write your message or cover letter request here..."></textarea>
                </div>

                <div id="contact-status" class="hidden p-3 rounded-lg text-sm font-medium"></div>

                <button type="submit" id="contact-submit-btn" class="w-full py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-lg hover:bg-slate-800 dark:hover:bg-slate-200 transition-colors flex items-center justify-center gap-2 cursor-pointer">
                    <span>Send Message</span>
                </button>
            </form>
        </div>

        <div>
            <h2 class="text-3xl font-heading font-bold mb-4">Community Polls <span class="text-sm font-normal text-slate-400 block sm:inline">(TBD: yet Claude-generated slope)</span></h2>
            <p class="mb-6 text-slate-600 dark:text-slate-300">
                I'm always curious about what others think regarding the future of tech and design. Vote below!
            </p>
            
            <PollComponent 
                id="poll-ai-creative" 
                question="How do you think AI will affect creative work in 5 years?" 
                options={["Mostly Enhance It", "Mostly Replace It", "No Major Change", "I'm Not Sure"]} 
            />
            
            <PollComponent 
                id="poll-hci" 
                question="What matters most in human-computer interaction?" 
                options={["Speed & Efficiency", "Intuitiveness", "Accessibility", "Emotional Design"]} 
            />
        </div>
        
    </div>

    <script>
        const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
        const statusEl = document.getElementById('contact-status');

        const TELEGRAM_BOT_TOKEN = '8948025496:AAFGid7HZaYX2NJ08ifN4E8L28qn5nInTZQ';
        const TELEGRAM_CHAT_ID = '649892453';

        if (contactForm && submitBtn && statusEl) {
            contactForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const nameInput = document.getElementById('name') as HTMLInputElement | null;
                const emailInput = document.getElementById('email') as HTMLInputElement | null;
                const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;

                const name = nameInput?.value.trim() || '';
                const email = emailInput?.value.trim() || '';
                const message = messageInput?.value.trim() || '';

                if (!name || !email || !message) return;

                submitBtn.disabled = true;
                submitBtn.textContent = 'Sending message...';
                statusEl.className = 'hidden';

                const textPayload = `📬 [Website Get In Touch]\n\n👤 Name: ${name}\n📧 Email: ${email}\n\n💬 Message:\n${message}\n\n⏰ Timestamp: ${new Date().toLocaleString()}`;

                try {
                    const response = await fetch(`https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            chat_id: TELEGRAM_CHAT_ID,
                            text: textPayload
                        })
                    });

                    if (response.ok) {
                        statusEl.className = 'p-3 rounded-lg text-sm font-medium bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800';
                        statusEl.textContent = '✓ Thank you! Your message has been sent directly to Olena.';
                        contactForm.reset();
                    } else {
                        throw new Error('Delivery failed');
                    }
                } catch {
                    statusEl.className = 'p-3 rounded-lg text-sm font-medium bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-300 dark:border-rose-800';
                    statusEl.textContent = 'There was an issue sending your message. Please reach out directly to ht.epistolist@gmail.com.';
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Send Message';
                }
            });
        }
    </script>
</Layout>
