---
import Layout from '../layouts/Layout.astro';
import pubData from '../data/publications.json';
import artData from '../data/art.json';

interface ArtItem {
    id: string;
    category: string;
    title: string;
    imageUrl?: string;
    description?: string;
    featured?: boolean;
    content?: string;
    date?: string;
}

interface TechItem {
    id: string;
    category: string;
    title: string;
    authors: string[];
    venue: string;
    year: number;
    abstract: string;
    posterUrl?: string;
    pdfUrl?: string;
    codeUrl?: string;
    bibtex?: string;
    tags: string[];
    featured: boolean;
}

const typedArtData = artData as ArtItem[];
const typedPubData = pubData as TechItem[];

// Tech Data
const featuredTech = typedPubData.filter(p => p.featured).slice(0, 3);
const archiveTech = typedPubData.filter(p => !p.featured || !featuredTech.includes(p));

// Art Categories: 5 of each under foldable headers
const poetryArt = typedArtData.filter(a => a.category === 'poetry').slice(0, 5);
const photoArt = typedArtData.filter(a => a.category === 'photo').slice(0, 5);
const visualArt = typedArtData.filter(a => a.category === 'visual' || a.category === 'graphic' || a.category === 'cad').slice(0, 5);

// Archive contains remaining art works
const displayedArtIds = new Set([
    ...poetryArt.map(a => a.id),
    ...photoArt.map(a => a.id),
    ...visualArt.map(a => a.id)
]);
const archiveArt = typedArtData.filter(a => !displayedArtIds.has(a.id));
---

<Layout title="Portfolio | Olena Teslia">
    <div class="mb-8 border-b border-slate-200 dark:border-slate-800">
        <h1 class="text-4xl font-heading font-bold mb-6">Portfolio</h1>
        
        <div class="flex gap-6">
            <button id="tab-tech" class="pb-3 text-lg font-bold border-b-2 border-accent-green dark:border-accent-green-dark text-slate-900 dark:text-white transition-colors">
                Tech
            </button>
            <button id="tab-art" class="pb-3 text-lg font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors">
                Art
            </button>
        </div>
    </div>

    <!-- Tech Tab -->
    <div id="content-tech" class="space-y-8 block">
        <h2 class="text-2xl font-heading font-bold mb-4 text-accent-green dark:text-accent-green-dark">Featured Tech</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredTech.map(p => (
                <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex gap-2 mb-2">
                            {p.tags.slice(0,2).map(tag => (
                                <span class="text-[10px] px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 rounded uppercase font-bold tracking-wider">{tag}</span>
                            ))}
                        </div>
                        <h3 class="text-xl font-bold mb-2">{p.title}</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">{p.authors.join(', ')} - {p.venue} ({p.year})</p>
                        <p class="text-sm mb-4 line-clamp-3 leading-relaxed">{p.abstract}</p>
                    </div>
                    <div class="flex gap-4 text-sm font-bold pt-2 border-t border-slate-100 dark:border-slate-800">
                        {p.posterUrl && <a href={p.posterUrl} target="_blank" rel="noopener noreferrer" class="text-accent-green dark:text-accent-green-dark hover:underline">Poster →</a>}
                        {p.pdfUrl && <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="text-accent-green dark:text-accent-green-dark hover:underline">PDF →</a>}
                        {p.codeUrl && <a href={p.codeUrl} target="_blank" rel="noopener noreferrer" class="text-accent-green dark:text-accent-green-dark hover:underline">Code →</a>}
                    </div>
                </div>
            ))}
        </div>
        
        <!-- Tech Archive with full descriptions -->
        <details class="group bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden">
            <summary class="p-4 font-bold cursor-pointer bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex justify-between items-center">
                <span class="flex items-center gap-2">
                    <span>Archive</span>
                    <span class="text-xs px-2.5 py-0.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-full font-medium">{archiveTech.length} projects</span>
                </span>
                <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-6 space-y-6">
                {archiveTech.map(p => (
                    <div class="border-b border-slate-200 dark:border-slate-700 pb-5 last:border-0 last:pb-0">
                        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
                            <h4 class="font-bold text-lg text-slate-900 dark:text-white">{p.title}</h4>
                            <span class="text-xs font-mono text-slate-400">{p.year}</span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">{p.authors.join(', ')} · {p.venue}</p>
                        <p class="text-sm text-slate-700 dark:text-slate-300 mb-3 leading-relaxed">{p.abstract}</p>
                        <div class="flex flex-wrap items-center gap-2">
                            {p.tags.map(tag => (
                                <span class="text-[10px] px-2 py-0.5 bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded font-medium">{tag}</span>
                            ))}
                            {p.posterUrl && <a href={p.posterUrl} target="_blank" rel="noopener noreferrer" class="ml-auto text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline">Poster →</a>}
                            {p.pdfUrl && <a href={p.pdfUrl} target="_blank" rel="noopener noreferrer" class="ml-auto text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline">PDF →</a>}
                            {p.codeUrl && <a href={p.codeUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline">Code →</a>}
                        </div>
                    </div>
                ))}
            </div>
        </details>
    </div>

    <!-- Art Tab -->
    <div id="content-art" class="space-y-8 hidden">

        <!-- 1. Foldable Header: Poetry -->
        <details class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden shadow-sm">
            <summary class="p-5 font-bold cursor-pointer bg-slate-50/70 dark:bg-slate-800/70 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex justify-between items-center select-none">
                <div class="flex items-center gap-3">
                    <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">Poetry</span>
                    <span class="text-xs px-2.5 py-0.5 bg-orange-100 dark:bg-orange-950/40 text-accent-orange dark:text-accent-orange-dark font-bold rounded-full">{poetryArt.length} works</span>
                </div>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                {poetryArt.map(poem => (
                    <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-6 rounded-xl flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <span class="text-[10px] px-2 py-0.5 bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 rounded uppercase font-bold tracking-wider">Poetry</span>
                                {poem.description && <span class="text-xs text-slate-400 font-mono">{poem.description}</span>}
                            </div>
                            <h3 class="text-xl font-bold mb-4 text-slate-900 dark:text-white">{poem.title}</h3>
                            {poem.content && (
                                <div class="text-sm whitespace-pre-wrap font-serif italic text-slate-700 dark:text-slate-300 border-l-2 border-accent-orange/70 pl-4 py-1 leading-relaxed">
                                    {poem.content}
                                </div>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </details>

        <!-- 2. Foldable Header: Photography -->
        <details class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden shadow-sm">
            <summary class="p-5 font-bold cursor-pointer bg-slate-50/70 dark:bg-slate-800/70 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex justify-between items-center select-none">
                <div class="flex items-center gap-3">
                    <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">Photography</span>
                    <span class="text-xs px-2.5 py-0.5 bg-orange-100 dark:bg-orange-950/40 text-accent-orange dark:text-accent-orange-dark font-bold rounded-full">{photoArt.length} works</span>
                </div>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {photoArt.map(photo => (
                    <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group/card">
                        <div class="w-full h-52 overflow-hidden bg-slate-200 dark:bg-slate-800 cursor-zoom-in">
                            <img
                                src={photo.imageUrl}
                                alt={photo.title}
                                data-full={photo.imageUrl}
                                data-title={photo.title}
                                class="expandable-img w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
                            />
                        </div>
                        <div class="p-4">
                            <span class="text-[10px] px-2 py-0.5 bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 rounded uppercase font-bold tracking-wider inline-block mb-2">Photo</span>
                            <h4 class="font-bold text-base line-clamp-2 text-slate-900 dark:text-white">{photo.title}</h4>
                            {photo.description && <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">{photo.description}</p>}
                        </div>
                    </div>
                ))}
            </div>
        </details>

        <!-- 3. Foldable Header: Visuals -->
        <details class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden shadow-sm">
            <summary class="p-5 font-bold cursor-pointer bg-slate-50/70 dark:bg-slate-800/70 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors flex justify-between items-center select-none">
                <div class="flex items-center gap-3">
                    <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">Visuals</span>
                    <span class="text-xs px-2.5 py-0.5 bg-orange-100 dark:bg-orange-950/40 text-accent-orange dark:text-accent-orange-dark font-bold rounded-full">{visualArt.length} works</span>
                </div>
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                {visualArt.map(art => (
                    <div class="bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group/card flex flex-col justify-between">
                        <div>
                            <div class="w-full h-52 overflow-hidden bg-slate-200 dark:bg-slate-800 cursor-zoom-in">
                                <img
                                    src={art.imageUrl}
                                    alt={art.title}
                                    data-full={art.imageUrl}
                                    data-title={art.title}
                                    class="expandable-img w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-300"
                                />
                            </div>
                            <div class="p-4">
                                <span class="text-[10px] px-2 py-0.5 bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 rounded uppercase font-bold tracking-wider inline-block mb-2 capitalize">{art.category}</span>
                                <h4 class="font-bold text-base mb-1.5 text-slate-900 dark:text-white">{art.title}</h4>
                                {art.description && <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{art.description}</p>}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </details>
        
        <!-- Art Archive with full descriptions and previews -->
        <details class="group bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden mt-8">
            <summary class="p-4 font-bold cursor-pointer bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex justify-between items-center">
                <span class="flex items-center gap-2">
                    <span>Archive</span>
                    <span class="text-xs px-2.5 py-0.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-full font-medium">{archiveArt.length} works</span>
                </span>
                <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
                {archiveArt.map(a => (
                    <div class="bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden p-4 flex gap-4 items-start shadow-sm">
                        {a.imageUrl && (
                            <div class="w-24 h-24 shrink-0 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 cursor-zoom-in">
                                <img
                                    src={a.imageUrl}
                                    alt={a.title}
                                    data-full={a.imageUrl}
                                    data-title={a.title}
                                    class="expandable-img w-full h-full object-cover hover:scale-105 transition-transform duration-200"
                                />
                            </div>
                        )}
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[10px] px-2 py-0.5 bg-orange-100 dark:bg-orange-950/40 text-accent-orange dark:text-accent-orange-dark uppercase font-bold tracking-wider rounded capitalize">{a.category}</span>
                            </div>
                            <h4 class="font-bold text-base mb-1 text-slate-900 dark:text-white">{a.title}</h4>
                            {a.description && <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{a.description}</p>}
                            {a.content && <p class="text-xs text-slate-500 italic line-clamp-3 mt-1 font-serif">{a.content}</p>}
                        </div>
                    </div>
                ))}
            </div>
        </details>
    </div>

    <!-- Full-screen Image Lightbox Modal -->
    <div id="image-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm hidden items-center justify-center p-4 cursor-zoom-out" aria-hidden="true">
        <button id="modal-close" class="absolute top-4 right-4 text-white/70 hover:text-white p-2 focus:outline-none" aria-label="Close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div class="relative max-w-5xl max-h-[90vh] flex flex-col items-center">
            <img id="modal-img" src="" alt="" class="max-w-full max-h-[82vh] object-contain rounded-lg shadow-2xl" />
            <p id="modal-caption" class="mt-3 text-center text-sm font-medium text-slate-300 font-heading"></p>
        </div>
    </div>

<script>
    function initPortfolio() {
        // Tab switching
        const tabTech = document.getElementById('tab-tech');
        const tabArt = document.getElementById('tab-art');
        const contentTech = document.getElementById('content-tech');
        const contentArt = document.getElementById('content-art');

        if (tabTech && tabArt && contentTech && contentArt) {
            const setTechActive = () => {
                tabTech.classList.add('border-accent-green', 'dark:border-accent-green-dark', 'text-slate-900', 'dark:text-white');
                tabTech.classList.remove('border-transparent', 'text-slate-500');
                
                tabArt.classList.remove('border-accent-orange', 'dark:border-accent-orange-dark', 'text-slate-900', 'dark:text-white');
                tabArt.classList.add('border-transparent', 'text-slate-500');
                
                contentTech.classList.remove('hidden');
                contentTech.classList.add('block');
                contentArt.classList.add('hidden');
                contentArt.classList.remove('block');
            };

            const setArtActive = () => {
                tabArt.classList.add('border-accent-orange', 'dark:border-accent-orange-dark', 'text-slate-900', 'dark:text-white');
                tabArt.classList.remove('border-transparent', 'text-slate-500');
                
                tabTech.classList.remove('border-accent-green', 'dark:border-accent-green-dark', 'text-slate-900', 'dark:text-white');
                tabTech.classList.add('border-transparent', 'text-slate-500');
                
                contentArt.classList.remove('hidden');
                contentArt.classList.add('block');
                contentTech.classList.add('hidden');
                contentTech.classList.remove('block');
            };

            tabTech.addEventListener('click', setTechActive);
            tabArt.addEventListener('click', setArtActive);
        }

        // Lightbox modal for expandable images
        const modal = document.getElementById('image-modal');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalCaption = document.getElementById('modal-caption');
        const modalClose = document.getElementById('modal-close');

        if (modal && modalImg && modalCaption) {
            const openModal = (src: string, title: string) => {
                modalImg.src = src;
                modalImg.alt = title;
                modalCaption.textContent = title;
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            };

            const closeModal = () => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                modalImg.src = '';
                document.body.style.overflow = '';
            };

            document.querySelectorAll('.expandable-img').forEach(img => {
                img.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const target = e.currentTarget as HTMLElement;
                    const src = target.getAttribute('data-full') || (target as HTMLImageElement).src;
                    const title = target.getAttribute('data-title') || (target as HTMLImageElement).alt || '';
                    if (src) openModal(src, title);
                });
            });

            modal.addEventListener('click', closeModal);
            modalClose?.addEventListener('click', (e) => {
                e.stopPropagation();
                closeModal();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }
    }

    initPortfolio();
    document.addEventListener('astro:page-load', initPortfolio);
</script>
</Layout>
