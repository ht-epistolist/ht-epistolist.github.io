  }
];

// Timeline time axis constants (2020.0 to 2028.5 = 8.5 years total span)
const minTime = 2020.0;
const totalSpan = 8.5;
const years = [2020, 2021, 2022, 2023, 2024, 2025, 2026, 2027, 2028];

const getPct = (time: number) => ((time - minTime) / totalSpan) * 100;
const getWidthPct = (start: number, end: number) => {
  const span = Math.max(0.18, end - start);
  return (span / totalSpan) * 100;
};
---

<Layout title="Olena Teslia | Career">
  <div class="mt-8 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="mb-10">
      <span class="inline-block mb-3 px-3 py-1 bg-accent-green text-white text-xs font-heading font-bold uppercase tracking-widest rounded-full">
        Open to Work
      </span>
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-2">Olena Teslia</h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 font-heading mb-6">
        Electrical Engineering @ Columbia · Research · Art · Volunteering
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <a
          href="/OlenaTeslia_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-green hover:bg-accent-green-dark text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>
        <a
          href="/surveys#feedback"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-accent-orange text-accent-orange hover:bg-accent-orange hover:text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Request Cover Letter
        </a>
      </div>
    </div>

    <!-- Statements -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <!-- Research Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-green rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-green mb-3">Research Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          I am an Electrical Engineering student at Columbia University with a focus on bioelectronics, robotics, and energy systems.
          My research at the Columbia Fusion Research Center has given me hands-on experience designing control and power systems
          for fusion experiments. I am passionate about applying rigorous engineering to problems at the frontier of energy and intelligent systems.
        </p>
      </div>
      <!-- Artist Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-orange rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-orange mb-3">Artist Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          With 9+ years in visual arts and 6+ years in poetry, I believe that creativity and engineering are not opposites —
          they are complementary ways of making sense of the world. My artistic practice explores structure, detail,
          and the unexpected beauty in technical forms.
        </p>
      </div>
    </div>

    <!-- Embedded Curriculum Vitae (Full 1-page PDF visible without internal vertical scrolling) -->
    <div class="mb-14 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-slate-900 dark:text-white">Curriculum Vitae</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Electrical Engineering & Applied Math · Columbia University · 1 Page Full View</p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/OlenaTeslia_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline flex items-center gap-1"
          >
            Open in new tab ↗
          </a>
          <a
            href="/OlenaTeslia_CV.pdf"
            download
            class="px-3.5 py-1.5 bg-accent-green hover:bg-accent-green-dark text-white text-xs font-heading font-semibold rounded-lg transition-colors shadow-sm"
          >
            Download PDF
          </a>
        </div>
      </div>
      
      <!-- Frame height 1150px on desktop so full US Letter page is visible without scroll clipping -->
      <div class="w-full h-[750px] sm:h-[950px] md:h-[1150px] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950">
        <object
          data="/OlenaTeslia_CV.pdf#toolbar=1"
          type="application/pdf"
          class="w-full h-full"
          title="Olena Teslia CV"
        >
          <iframe
            src="/OlenaTeslia_CV.pdf#toolbar=1"
            class="w-full h-full border-0"
            title="Olena Teslia CV"
          >
          </iframe>
        </object>
      </div>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- INTERACTIVE GANTT-STYLE CHRONOLOGICAL TIMELINE (OVERLAPS)    -->
    <!-- ------------------------------------------------------------- -->
    <div class="mb-14">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
        <div>
          <h2 class="font-heading font-bold text-2xl text-slate-900 dark:text-white">Commitments & Timeline</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Visualizing simultaneous & concurrent commitments across engineering, research, and leadership. Click any bar to jump to its details below.
          </p>
        </div>
        <!-- Category Legend -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-medium">
          <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
            <span class="w-3 h-3 rounded-sm bg-emerald-600"></span> Research & Education
          </span>
          <span class="inline-flex items-center gap-1.5 text-orange-600 dark:text-orange-400">
            <span class="w-3 h-3 rounded-sm bg-orange-600"></span> Leadership & Community
          </span>
          <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
            <span class="w-3 h-3 rounded-sm bg-slate-500"></span> Industry & Engineering
          </span>
        </div>
      </div>

      <!-- Gantt Chart Container (Scrollable on small mobile) -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-sm overflow-x-auto">
        <div class="min-w-[680px] relative">
          
          <!-- Year Axis Header -->
          <div class="relative h-7 border-b border-slate-200 dark:border-slate-800 mb-4 text-xs font-mono text-slate-400 font-bold select-none">
            {years.map(y => (
              <div
                class="absolute -translate-x-1/2 flex flex-col items-center"
                style={`left: ${getPct(y)}%;`}
              >
                <span>{y}</span>
                <span class="w-px h-1.5 bg-slate-300 dark:bg-slate-700 mt-1"></span>
              </div>
            ))}
          </div>

          <!-- Vertical Year Grid Lines (Background) -->
          <div class="absolute inset-0 top-7 pointer-events-none z-0">
            {years.map(y => (
              <div
                class="absolute top-0 bottom-0 w-px border-r border-dashed border-slate-100 dark:border-slate-800/80"
                style={`left: ${getPct(y)}%;`}
              />
            ))}
          </div>

          <!-- Timeline Bars Section -->
          <div class="relative z-10 space-y-2.5 pt-1 pb-2">
            {timelineData.map(item => {
              const left = getPct(item.start);
              const width = getWidthPct(item.start, item.end);
              
              let barStyle = "bg-emerald-600 hover:bg-emerald-500 text-white border-emerald-400/30";
              if (item.category === 'leadership') {
                barStyle = "bg-orange-600 hover:bg-orange-500 text-white border-orange-400/30";
              } else if (item.category === 'industry') {
                barStyle = "bg-slate-600 hover:bg-slate-500 text-white border-slate-400/30";
              }

              return (
                <div class="relative h-8 flex items-center group/track">
                  <!-- Bar Link / Button -->
                  <a
                    href={`#${item.id}`}
                    data-target={item.id}
                    class={`gantt-bar absolute h-7 rounded-md px-2.5 flex items-center justify-between text-xs font-heading font-semibold shadow-sm transition-all duration-200 cursor-pointer overflow-hidden border ${barStyle} hover:scale-[1.01] hover:shadow-md hover:z-20`}
                    style={`left: ${left}%; width: ${width}%; min-width: 60px;`}
                    title={`${item.title} (${item.dateStr})`}
                  >
                    <span class="truncate font-medium">{item.shortTitle}</span>
                    
                    {item.ongoing && (
                      <span class="shrink-0 ml-1.5 w-2 h-2 rounded-full bg-white animate-pulse" title="Ongoing Active Commitment"></span>
                    )}
                  </a>
                </div>
              );
            })}
          </div>

        </div>

        <p class="text-[11px] text-slate-400 dark:text-slate-500 text-right mt-3 font-mono">
          Tip: Click any bar to jump & highlight its detailed section below
        </p>
      </div>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- DETAILED COMMITMENT CARDS (CHRONOLOGICAL WITH OVERLAPS)       -->
    <!-- ------------------------------------------------------------- -->
    <h2 class="font-heading font-bold text-2xl mb-6">Experience & Roles</h2>
    
    <div class="space-y-6 mb-16">
      {timelineData.map(item => {
        let badgeColor = "bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800";
        let borderAccent = "border-l-accent-green";
        if (item.category === 'leadership') {
          badgeColor = "bg-orange-100 dark:bg-orange-950/50 text-orange-800 dark:text-orange-300 border-orange-300 dark:border-orange-800";
          borderAccent = "border-l-accent-orange";
        } else if (item.category === 'industry') {
          badgeColor = "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700";
          borderAccent = "border-l-slate-400";
        }

        return (
          <div
            id={item.id}
            class={`exp-card scroll-mt-24 bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 border-l-4 ${borderAccent} transition-all duration-300`}
          >
            <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class={`text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider border ${badgeColor}`}>
                    {item.categoryLabel}
                  </span>
                  {item.ongoing && (
                    <span class="text-[10px] px-2 py-0.5 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-full font-semibold flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Ongoing
                    </span>
                  )}
                  {item.location && (
                    <span class="text-xs text-slate-400 font-medium">· {item.location}</span>
                  )}
                </div>
                <h3 class="font-heading font-bold text-lg text-slate-900 dark:text-white">
                  {item.title}
                </h3>
              </div>
              <span class="text-xs font-mono font-semibold text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-100 dark:border-slate-700">
                {item.dateStr}
              </span>
            </div>

            {item.overlapNotes && (
              <div class="mb-3 inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/50 px-2.5 py-1 rounded-md border border-slate-200/50 dark:border-slate-800">
                <span class="text-accent-orange font-bold font-mono">⟷</span>
                <span>{item.overlapNotes}</span>
              </div>
            )}

            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.description}
            </p>
          </div>
        );
      })}

      <!-- Foundation: Dnipro Art School -->
      <div
        id="exp-dnipro-art"
        class="exp-card scroll-mt-24 bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 border-l-4 border-l-accent-orange transition-all duration-300"
      >
        <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider border bg-orange-100 dark:bg-orange-950/50 text-orange-800 dark:text-orange-300 border-orange-300 dark:border-orange-800">
                Artistic Foundation
              </span>
              <span class="text-xs text-slate-400 font-medium">· Dnipro, Ukraine</span>
            </div>
            <h3 class="font-heading font-bold text-lg text-slate-900 dark:text-white">
              Dnipro Art School
            </h3>
          </div>
          <span class="text-xs font-mono font-semibold text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-100 dark:border-slate-700">
            Sep 2015 – Jun 2019
          </span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          4 years of formal fine art education in drawing, academic painting, graphics, and classical composition.
        </p>
      </div>
    </div>

    <!-- Skills -->
    <div class="mt-16 mb-12">
      <h2 class="font-heading font-bold text-2xl mb-6">Skills & Competencies</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-green mb-2">Software & Tools</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">SolidWorks, Fusion360, OnShape, Altium, LTspice, Visual Studio, Git, Linux</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-green mb-2">Programming</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Python, Java, SQL, Kotlin, MATLAB, JavaScript, LaTeX, C++, Haskell, Bash</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-orange mb-2">Machining & Fabrication</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">3D printing (PLA, ABS), waterjet, laser cutter, vertical bandsaw, electronics, woodshop</p>
        </div>
        <div class="bg-white dark:bg-slate-900 rounded-xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-orange mb-2">Languages</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">English (Full Professional), Ukrainian (Native), Russian (Native), Polish (Elementary)</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Smooth Scroll and Interactive Highlight Script -->
  <script>
    function initCareerTimeline() {
      const bars = document.querySelectorAll('.gantt-bar');
      bars.forEach(bar => {
        bar.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = bar.getAttribute('data-target');
          if (!targetId) return;

          const targetCard = document.getElementById(targetId);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Flash highlight ring
            targetCard.classList.add('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            setTimeout(() => {
              targetCard.classList.remove('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            }, 1800);
          }
        });
      });
    }

    initCareerTimeline();
    document.addEventListener('astro:page-load', initCareerTimeline);
  </script>
</Layout>
