---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Olena Teslia | Career">
  <div class="mt-8 max-w-3xl mx-auto">

    <!-- Header -->
    <div class="mb-10">
      <span class="inline-block mb-3 px-3 py-1 bg-accent-green text-white text-xs font-heading font-bold uppercase tracking-widest rounded-full">
        Open to Work
      </span>
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-2">Olena Teslia</h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 font-heading mb-6">
        Electrical Engineering @ Columbia · Research · Art · Volunteering
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <a
          href="/OlenaTeslia_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-green hover:bg-accent-green-dark text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>
        <a
          href="/surveys#feedback"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-accent-orange text-accent-orange hover:bg-accent-orange hover:text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Request Cover Letter
        </a>
      </div>
    </div>

    <!-- Statements -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <!-- Research Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-green rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-green mb-3">Research Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          I am an Electrical Engineering student at Columbia University with a focus on bioelectronics, robotics, and energy systems.
          My research at the Columbia Fusion Research Center has given me hands-on experience designing control and power systems
          for fusion experiments. I am passionate about applying rigorous engineering to problems at the frontier of energy and intelligent systems.
        </p>
      </div>
      <!-- Artist Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-orange rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-orange mb-3">Artist Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          With 9+ years in visual arts and 6+ years in poetry, I believe that creativity and engineering are not opposites —
          they are complementary ways of making sense of the world. My artistic practice explores structure, detail,
          and the unexpected beauty in technical forms.
        </p>
      </div>
    </div>

    <!-- Embedded Curriculum Vitae -->
    <div class="mb-12 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-slate-900 dark:text-white">Curriculum Vitae</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Electrical Engineering & Applied Math · Columbia University</p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/OlenaTeslia_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline flex items-center gap-1"
          >
            Open in new tab ↗
          </a>
          <a
            href="/OlenaTeslia_CV.pdf"
            download
            class="px-3.5 py-1.5 bg-accent-green hover:bg-accent-green-dark text-white text-xs font-heading font-semibold rounded-lg transition-colors shadow-sm"
          >
            Download PDF
          </a>
        </div>
      </div>
      <div class="w-full h-[650px] sm:h-[800px] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950">
        <object
          data="/OlenaTeslia_CV.pdf#toolbar=1"
          type="application/pdf"
          class="w-full h-full"
          title="Olena Teslia CV"
        >
          <iframe
            src="/OlenaTeslia_CV.pdf#toolbar=1"
            class="w-full h-full border-0"
            title="Olena Teslia CV"
          >
          </iframe>
        </object>
      </div>
    </div>

    <!-- Timeline -->
    <h2 class="font-heading font-bold text-2xl mb-8">Timeline</h2>
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-700"></div>

      <div class="space-y-8">

        <!-- Columbia Engineering Lab Assistant -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-green flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Columbia Engineering — Laboratory Assistant</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Sep 2026 – Present</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Signals and Systems lab assistant, supporting coursework and experiments.</p>
          </div>
        </div>

        <!-- Brave1 -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-slate-400 flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Brave1 — Components Intern</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Jun – Sep 2026</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Interviewed 10+ companies and distributors; conducted supply chain research collecting 40+ responses; organized a webinar for 30+ participants.</p>
          </div>
        </div>

        <!-- CUTE Research -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-green flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Columbia Fusion Research Center — Research Assistant (CUTE)</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Jun 2026 – Present</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Designing, wiring, and testing power, control, and safety systems for the Columbia University Tokamak for Education (20+ hrs/week). Wired high-voltage power supply and capacitor banks; established network connection with oscilloscope.</p>
          </div>
        </div>

        <!-- Student Reunion -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-slate-400 flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Columbia University — Student Reunion Worker</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">May 2026</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Campus event staffing for the annual Columbia University reunion.</p>
          </div>
        </div>

        <!-- Engineering Without Borders -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-orange flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Engineering Without Borders — Fundraising Co-Lead</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Sep 2024 – Jan 2026</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Reached out to companies, co-organized fundraisers, applied for grants, and conducted weekly team meetings.</p>
          </div>
        </div>

        <!-- CSX Research -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-green flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Columbia Fusion Research Center — Research Assistant (CSX)</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Sep 2025 – May 2026</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Columbia Stellarator eXperiment: modeled a rotating winding stand, developed a Hall probe magnetic field sensor, and collaborated in assembly of the vacuum chamber setup and CAD modeling.</p>
          </div>
        </div>

        <!-- Columbia University Education -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-green flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Columbia University, SEAS — BS Electrical Engineering</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Sep 2024 – May 2028</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">GPA: 3.81/4.00. Minors in Applied Mathematics and Computer Science. Coursework: Quantum Computing Lab, Signals and Systems, Electronic Circuits, Electromagnetics, Solid State Devices, Probability Theory. Extracurriculars: NeurotechX, FormulaSAE, Pi Mu Epsilon, Hackhouse, AI Safety.</p>
          </div>
        </div>

        <!-- Program on AI and Reasoning -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-orange flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Program on AI and Reasoning — Junior Counselor</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Aug 2023 & Aug 2025</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Assisted a 10-day workshop studying math, cognition, and AI/ML for 25 participants selected from 1200+ applicants. Led a lecture on the brain and organized 7+ activities in a 15-person staff team.</p>
          </div>
        </div>

        <!-- IMO Volunteer -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-orange flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">International Mathematics Olympiad — Volunteer</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Jul 2024 · Bath, UK</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Guided a team of 6 participants throughout the 10-day event. Organized excursions for 100+ people and welcomed 80+ teams totalling 500+ members.</p>
          </div>
        </div>

        <!-- Berkhamsted School -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-green flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
          </div>
          <div class="bg-white dark:bg-slate-900 rounded-xl p-5 shadow-sm border border-slate-100 dark:border-slate-800">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
              <h3 class="font-heading font-bold text-base">Berkhamsted School — A-Levels</h3>
              <span class="text-xs font-heading text-slate-400 whitespace-nowrap">Sep 2022 – Jun 2024 · UK</span>
            </div>
            <p class="text-sm text-slate-600 dark:text-slate-400">Further Maths (A), Physics (A), Computer Science (A), Maths (A*).</p>
          </div>
        </div>

        <!-- Ukraine Global Scholars -->
        <div class="relative pl-12">
          <div class="absolute left-0 w-8 h-8 rounded-full bg-accent-orange flex items-center justify-center shadow-md">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
