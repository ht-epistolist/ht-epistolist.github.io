  <!-- Smooth Scroll and Interactive Highlight Script -->
  <script>
    function initCareerTimeline() {
      // Gantt bar click to card jump & highlight
      const bars = document.querySelectorAll('.gantt-bar');
      bars.forEach(bar => {
        bar.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = bar.getAttribute('data-target');
          if (!targetId) return;

          const targetCard = document.getElementById(targetId);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Flash highlight ring
            targetCard.classList.add('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            setTimeout(() => {
              targetCard.classList.remove('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            }, 1800);
          }
        });
      });

      // Expand / Collapse height toggle
      const toggleBtn = document.getElementById('toggle-timeline-height');
      const ganttContainer = document.getElementById('gantt-scroll-container');
      const toggleLabel = document.getElementById('toggle-timeline-label');

      if (toggleBtn && ganttContainer && toggleLabel) {
        toggleBtn.addEventListener('click', () => {
          if (ganttContainer.classList.contains('max-h-[290px]')) {
            ganttContainer.classList.remove('max-h-[290px]');
            toggleLabel.textContent = 'Collapse Rows ↕';
          } else {
            ganttContainer.classList.add('max-h-[290px]');
            toggleLabel.textContent = 'Expand Rows ↕';
          }
        });
      }
    }

    initCareerTimeline();
    document.addEventListener('astro:page-load', initCareerTimeline);
  </script>
