---
import Layout from '../layouts/Layout.astro';

interface TimelineBar {
  id: string;
  title: string;
  shortTitle: string;
  start: number;
  end: number;
  ongoing?: boolean;
  dateStr: string;
}

interface TimelineTrack {
  id: string;
  category: 'research' | 'volunteering' | 'industry';
  categoryLabel: string;
  bars: TimelineBar[];
}

interface ExperienceCard {
  id: string;
  title: string;
  role: string;
  org: string;
  category: 'research' | 'volunteering' | 'industry' | 'education';
  categoryLabel: string;
  dateStr: string;
  ongoing?: boolean;
  overlapNotes?: string;
  description: string;
  location?: string;
}

// -------------------------------------------------------------
// Zoomed Time Axis: 2023 to 2026 (4-year high-resolution view)
// -------------------------------------------------------------
const minTime = 2023.0;
const maxTime = 2027.0;
const totalSpan = maxTime - minTime; // 4.0 years span
const years = [2023, 2024, 2025, 2026, 2027];

const getPct = (time: number) => Math.max(0, Math.min(100, ((time - minTime) / totalSpan) * 100));
const getWidthPct = (start: number, end: number) => {
  const s = Math.max(start, minTime);
  const e = Math.min(end, maxTime);
  return (Math.max(0.08, e - s) / totalSpan) * 100;
};

