  <!-- Smooth Scroll and Interactive Highlight Script -->
  <script>
    function initCareerTimeline() {
      // Gantt bar or left label click to card jump & highlight
      const clickableElements = document.querySelectorAll('.gantt-bar, .gantt-label-link');
      clickableElements.forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = el.getAttribute('data-target');
          if (!targetId) return;

          const targetCard = document.getElementById(targetId);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Flash highlight ring
            targetCard.classList.add('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            setTimeout(() => {
              targetCard.classList.remove('ring-4', 'ring-accent-green', 'dark:ring-accent-green');
            }, 1800);
          }
        });
      });

      // Volunteering Fold / Unfold toggle
      const volToggle = document.getElementById('volunteering-toggle');
      const volFoldedRow = document.getElementById('volunteering-folded-row');
      const volUnfoldedLeft = document.getElementById('volunteering-unfolded-left');
      const volUnfoldedTimeline = document.getElementById('volunteering-unfolded-timeline');
      const volChevron = document.getElementById('vol-chevron');
      const volToggleText = document.getElementById('vol-toggle-text');

      if (volToggle && volFoldedRow && volUnfoldedLeft && volUnfoldedTimeline && volChevron && volToggleText) {
        let isFolded = true;
        volToggle.onclick = () => {
          isFolded = !isFolded;
          if (isFolded) {
            volFoldedRow.classList.remove('hidden');
            volUnfoldedLeft.classList.add('hidden');
            volUnfoldedTimeline.classList.add('hidden');
            volChevron.textContent = '▶';
            volToggleText.textContent = 'Unfold';
          } else {
            volFoldedRow.classList.add('hidden');
            volUnfoldedLeft.classList.remove('hidden');
            volUnfoldedTimeline.classList.remove('hidden');
            volChevron.textContent = '▼';
            volToggleText.textContent = 'Fold';
          }
        };
      }

      // Initialize timeline scroll to present/recent engagements, allowing user to scroll left for earlier history
      const scrollContainer = document.getElementById('gantt-timeline-scroll');
      if (scrollContainer) {
        // Small delay to ensure layout computation
        setTimeout(() => {
          scrollContainer.scrollLeft = scrollContainer.scrollWidth - scrollContainer.clientWidth;
        }, 60);
      }
    }

    initCareerTimeline();
    document.addEventListener('astro:page-load', initCareerTimeline);
  </script>
