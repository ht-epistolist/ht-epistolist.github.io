// -------------------------------------------------------------
// Time Axis: 2020 to 2027 (7-year span, allows scrolling left to see past history)
// -------------------------------------------------------------
const minTime = 2020.0;
const maxTime = 2027.0;
const totalSpan = maxTime - minTime; // 7.0 years span
const years = [2020, 2021, 2022, 2023, 2024, 2025, 2026, 2027];

const getPct = (time: number) => Math.max(0, Math.min(100, ((time - minTime) / totalSpan) * 100));
const getWidthPct = (start: number, end: number) => {
  const s = Math.max(start, minTime);
  const e = Math.min(end, maxTime);
  return (Math.max(0.09, e - s) / totalSpan) * 100;
};

