---

<Layout title="Olena Teslia | Career">
  <div class="mt-8 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="mb-10">
      <span class="inline-block mb-3 px-3 py-1 bg-accent-green text-white text-xs font-heading font-bold uppercase tracking-widest rounded-full">
        Open to Work
      </span>
      <h1 class="text-4xl md:text-5xl font-heading font-bold mb-2">Olena Teslia</h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 font-heading mb-6">
        Electrical Engineering @ Columbia · Research · Art · Volunteering
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <a
          href="/OlenaTeslia_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-green hover:bg-accent-green-dark text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download CV
        </a>
        <a
          href="/surveys#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-accent-orange text-accent-orange hover:bg-accent-orange hover:text-white font-heading font-semibold rounded-lg transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Request Cover Letter
        </a>
      </div>
    </div>

    <!-- Statements -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <!-- Research Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-green rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-green mb-3">Research Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          I am an Electrical Engineering student at Columbia University with a focus on bioelectronics, robotics, and energy systems.
          My research at the Columbia Fusion Research Center has given me hands-on experience designing control and power systems
          for fusion experiments. I am passionate about applying rigorous engineering to problems at the frontier of energy and intelligent systems.
        </p>
      </div>
      <!-- Artist Statement -->
      <div class="bg-white dark:bg-slate-900 border-l-4 border-accent-orange rounded-r-xl p-6 shadow-sm">
        <h2 class="font-heading font-bold text-sm uppercase tracking-widest text-accent-orange mb-3">Artist Statement (TBD: yet Claude-generated slope)</h2>
        <p class="font-serif text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
          With 9+ years in visual arts and 6+ years in poetry, I believe that creativity and engineering are not opposites —
          they are complementary ways of making sense of the world. My artistic practice explores structure, detail,
          and the unexpected beauty in technical forms.
        </p>
      </div>
    </div>

    <!-- Embedded Curriculum Vitae (Full 1-page PDF visible without internal vertical scrolling) -->
    <div class="mb-14 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="font-heading font-bold text-xl text-slate-900 dark:text-white">Curriculum Vitae</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Electrical Engineering & Applied Math · Columbia University · 1 Page Full View</p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/OlenaTeslia_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-accent-green dark:text-accent-green-dark hover:underline flex items-center gap-1"
          >
            Open in new tab ↗
          </a>
          <a
            href="/OlenaTeslia_CV.pdf"
            download
            class="px-3.5 py-1.5 bg-accent-green hover:bg-accent-green-dark text-white text-xs font-heading font-semibold rounded-lg transition-colors shadow-sm"
          >
            Download PDF
          </a>
        </div>
      </div>
      
      <!-- Frame height 1150px on desktop so full US Letter page is visible without scroll clipping -->
      <div class="w-full h-[750px] sm:h-[950px] md:h-[1150px] rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-950">
        <object
          data="/OlenaTeslia_CV.pdf#toolbar=1"
          type="application/pdf"
          class="w-full h-full"
          title="Olena Teslia CV"
        >
          <iframe
            src="/OlenaTeslia_CV.pdf#toolbar=1"
            class="w-full h-full border-0"
            title="Olena Teslia CV"
          >
          </iframe>
        </object>
      </div>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- INTERACTIVE GANTT-STYLE CHRONOLOGICAL TIMELINE (2023–2026)   -->
    <!-- ------------------------------------------------------------- -->
    <div class="mb-14">
      <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
        <div>
          <h2 class="font-heading font-bold text-2xl text-slate-900 dark:text-white">Commitments Timeline (2023–2026)</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Zoomed high-resolution view of concurrent research, volunteering, and industry engagements.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Category Legend -->
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium">
            <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
              <span class="w-2.5 h-2.5 rounded-sm bg-emerald-600"></span> Research
            </span>
            <span class="inline-flex items-center gap-1.5 text-orange-600 dark:text-orange-400">
              <span class="w-2.5 h-2.5 rounded-sm bg-orange-600"></span> Volunteering & Leadership
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
              <span class="w-2.5 h-2.5 rounded-sm bg-slate-500"></span> Industry
            </span>
          </div>

          <!-- Height Toggle Button -->
          <button
            id="toggle-timeline-height"
            type="button"
            class="text-[11px] font-mono font-medium px-2.5 py-1 rounded-md border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors flex items-center gap-1 cursor-pointer"
            title="Expand or condense vertical timeline height"
          >
            <span id="toggle-timeline-label">Expand Rows ↕</span>
          </button>
        </div>
      </div>

      <!-- Gantt Chart Container (Condensed rows, zoomed 2023-2026, scrollable with expandable height) -->
      <div
        id="gantt-scroll-container"
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm overflow-x-auto overflow-y-auto max-h-[290px] transition-[max-height] duration-300"
      >
        <div class="min-w-[720px] relative">
          
          <!-- Year Axis Header -->
          <div class="relative h-6 border-b border-slate-200 dark:border-slate-800 mb-3 text-xs font-mono text-slate-400 font-bold select-none">
            {years.map(y => (
              <div
                class="absolute -translate-x-1/2 flex flex-col items-center"
                style={`left: ${getPct(y)}%;`}
              >
                <span>{y}</span>
                <span class="w-px h-1.5 bg-slate-300 dark:bg-slate-700 mt-0.5"></span>
              </div>
            ))}
          </div>

          <!-- Vertical Year Grid Lines (Background) -->
          <div class="absolute inset-0 top-6 pointer-events-none z-0">
            {years.map(y => (
              <div
                class="absolute top-0 bottom-0 w-px border-r border-dashed border-slate-100 dark:border-slate-800/80"
                style={`left: ${getPct(y)}%;`}
              />
            ))}
          </div>

          <!-- Timeline Condensed Tracks Section -->
          <div class="relative z-10 space-y-1.5 pt-0.5 pb-1.5">
            {timelineTracks.map(track => {
              let defaultStyle = "bg-emerald-600 hover:bg-emerald-500 text-white border-emerald-400/30";
              if (track.category === 'volunteering') {
                defaultStyle = "bg-orange-600 hover:bg-orange-500 text-white border-orange-400/30";
              } else if (track.category === 'industry') {
                defaultStyle = "bg-slate-600 hover:bg-slate-500 text-white border-slate-400/30";
              }

              return (
                <div class="relative h-6 flex items-center group/track">
                  {track.bars.map(bar => {
                    const left = getPct(bar.start);
                    const width = getWidthPct(bar.start, bar.end);

                    return (
                      <a
                        href={`#${bar.id}`}
                        data-target={bar.id}
                        class={`gantt-bar absolute h-5.5 rounded px-2 flex items-center justify-between text-[11px] font-heading font-semibold shadow-sm transition-all duration-200 cursor-pointer overflow-hidden border ${defaultStyle} hover:scale-[1.01] hover:shadow-md hover:z-20`}
                        style={`left: ${left}%; width: ${width}%; min-width: 52px;`}
                        title={`${bar.title} (${bar.dateStr})`}
                      >
                        <span class="truncate font-medium">{bar.shortTitle}</span>
                        {bar.ongoing && (
                          <span class="shrink-0 ml-1 w-1.5 h-1.5 rounded-full bg-white animate-pulse" title="Ongoing Active Commitment"></span>
                        )}
                      </a>
                    );
                  })}
                </div>
              );
            })}
          </div>

        </div>
      </div>
    </div>

    <!-- ------------------------------------------------------------- -->
    <!-- DETAILED EXPERIENCE CARDS                                     -->
    <!-- ------------------------------------------------------------- -->
    <h2 class="font-heading font-bold text-2xl mb-6">Experience & Roles</h2>
    
    <div class="space-y-6 mb-16">
      {allExperienceCards.map(item => {
        let badgeColor = "bg-emerald-100 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800";
        let borderAccent = "border-l-accent-green";
        if (item.category === 'volunteering') {
          badgeColor = "bg-orange-100 dark:bg-orange-950/50 text-orange-800 dark:text-orange-300 border-orange-300 dark:border-orange-800";
          borderAccent = "border-l-accent-orange";
        } else if (item.category === 'industry') {
          badgeColor = "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700";
          borderAccent = "border-l-slate-400";
        }

        return (
          <div
            id={item.id}
            class={`exp-card scroll-mt-24 bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 border-l-4 ${borderAccent} transition-all duration-300`}
          >
            <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <span class={`text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider border ${badgeColor}`}>
                    {item.categoryLabel}
                  </span>
                  {item.ongoing && (
                    <span class="text-[10px] px-2 py-0.5 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-full font-semibold flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Ongoing
                    </span>
                  )}
                  {item.location && (
                    <span class="text-xs text-slate-400 font-medium">· {item.location}</span>
                  )}
                </div>
                <h3 class="font-heading font-bold text-lg text-slate-900 dark:text-white">
                  {item.title}
                </h3>
              </div>
              <span class="text-xs font-mono font-semibold text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-100 dark:border-slate-700">
                {item.dateStr}
              </span>
